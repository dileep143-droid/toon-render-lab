[
 {
  "unit": 0,
  "start": 0.431,
  "end": 10.781,
  "hindi_on": 0.431,
  "hindi_off": 11.881,
  "dur": 10.35,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇది సోంపూర్ ఊరు. ఇక్కడ ఉంది అవ్వ ముంగిలి! ఈ సాయంత్రం ఇక్కడ పూజుంది, అవ్వ తన ప్రసిద్ధ శనగపిండి లడ్డూలు చేస్తోంది!",
  "cut": false
 },
 {
  "unit": 1,
  "start": 12.347,
  "end": 19.697,
  "hindi_on": 12.347,
  "hindi_off": 20.457,
  "dur": 7.35,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఒకటీ, రెండు, మూడు... పదకొండు లడ్డూలు! చాలు, పూజకి సరిపోనాయి!",
  "cut": false
 },
 {
  "unit": 2,
  "start": 21.341,
  "end": 29.631,
  "hindi_on": 21.341,
  "hindi_off": 29.251,
  "dur": 8.99,
  "tempo": 1.084,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఆహా... ఎంత మంచి కమ్మటి వాసనో! బామ్మ, నాకు ఆకలేస్తోంది!",
  "cut": false
 },
 {
  "unit": 3,
  "start": 29.755,
  "end": 32.955,
  "hindi_on": 29.755,
  "hindi_off": 32.485,
  "dur": 3.2,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇప్పుడేటి నాలుగు పరోటాలు తిన్నావురా, చోటూ!",
  "cut": false
 },
 {
  "unit": 4,
  "start": 33.408,
  "end": 37.258,
  "hindi_on": 33.408,
  "hindi_off": 36.548,
  "dur": 4.44,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.331,
  "early": 0.0,
  "text": "అది ప్రొద్దుటి ఆకలి బామ్మ! ఇది ఇప్పటి ఆకలి!",
  "cut": false
 },
 {
  "unit": 5,
  "start": 37.378,
  "end": 45.308,
  "hindi_on": 37.047,
  "hindi_off": 44.487,
  "dur": 8.48,
  "tempo": 1.069,
  "drift": 0.331,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఈ లడ్డూలు దేవుడి కోసమే. పూజయ్యాక అందరికీ ఇత్తాను. అప్పటిదాకా ఎవ్వరూ చెయ్యి పెట్టకూడదు, విన్నావా?",
  "cut": false
 },
 {
  "unit": 6,
  "start": 45.432,
  "end": 47.912,
  "hindi_on": 45.432,
  "hindi_off": 47.542,
  "dur": 2.48,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "అర్థమైంది బామ్మ! చెయ్యి అసలు పెట్టను!",
  "cut": false
 },
 {
  "unit": 7,
  "start": 55.495,
  "end": 60.725,
  "hindi_on": 55.495,
  "hindi_off": 59.305,
  "dur": 5.23,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఓలమ్మో, నా కళ్లజోడు ఎక్కడికెళ్ళింది? ఇక్కడే ఉన్నాదిగా!",
  "cut": false
 },
 {
  "unit": 9,
  "start": 61.419,
  "end": 66.759,
  "hindi_on": 61.419,
  "hindi_off": 67.079,
  "dur": 5.34,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "సమకీ, నువ్వుకూడా సెప్పవులే. సరే, సేపు పడుకుంటాను.",
  "cut": false
 },
 {
  "unit": 10,
  "start": 67.935,
  "end": 76.185,
  "hindi_on": 67.935,
  "hindi_off": 75.965,
  "dur": 8.25,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "మధ్యాహ్నం అయింది. బామ్మ పడుకుంది. షేరూ పడుకున్నాడు. కానీ చోటూ కడుపు... అస్సలు పడుకోలేదు!",
  "cut": false
 },
 {
  "unit": 11,
  "start": 76.465,
  "end": 80.565,
  "hindi_on": 76.465,
  "hindi_off": 79.725,
  "dur": 4.21,
  "tempo": 1.029,
  "drift": 0.0,
  "spill": 0.007,
  "early": 0.0,
  "text": "ష్ష్, కడుపు బాబాయ్! ఊరుకో! బామ్మ మేల్కొంటుంది.",
  "cut": false
 },
 {
  "unit": 12,
  "start": 80.685,
  "end": 84.285,
  "hindi_on": 80.678,
  "hindi_off": 84.518,
  "dur": 3.6,
  "tempo": 1.0,
  "drift": 0.007,
  "spill": 0.0,
  "early": 0.0,
  "text": "బామ్మ చెయ్యి పెట్టొద్దంది కదా. అందుకే నేను... నోరు పెడతాను!",
  "cut": false
 },
 {
  "unit": 13,
  "start": 85.039,
  "end": 87.499,
  "hindi_on": 85.039,
  "hindi_off": 87.109,
  "dur": 2.8,
  "tempo": 1.135,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఎమ్మ్మ్! ఒక్కటే. ఒకే ఒక్కటి!",
  "cut": false
 },
 {
  "unit": 14,
  "start": 87.625,
  "end": 90.935,
  "hindi_on": 87.625,
  "hindi_off": 91.555,
  "dur": 3.31,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "\"ఒక్కటే\" అంటూ అంటూ చోటూ లెక్కపెట్టడమే మానేశాడు.",
  "cut": false
 },
 {
  "unit": 15,
  "start": 92.497,
  "end": 95.207,
  "hindi_on": 92.497,
  "hindi_off": 95.487,
  "dur": 2.71,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇది తర్వాత కోసం. తరువాత వచ్చే ఆకలి కోసం!",
  "cut": false
 },
 {
  "unit": 16,
  "start": 95.975,
  "end": 98.355,
  "hindi_on": 95.975,
  "hindi_off": 98.705,
  "dur": 2.38,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "వద్దు షేరూ, పడుకో! నువ్వేమీ చూడట్లేదు అసలు!",
  "cut": false
 },
 {
  "unit": 17,
  "start": 102.067,
  "end": 106.537,
  "hindi_on": 102.067,
  "hindi_off": 106.587,
  "dur": 4.47,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఓరి దేవుడా! నా లడ్డూలు! పళ్లెం ఖాళీగా ఉన్నాది!",
  "cut": false
 },
 {
  "unit": 18,
  "start": 107.527,
  "end": 110.417,
  "hindi_on": 107.527,
  "hindi_off": 110.697,
  "dur": 2.89,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఏంటి? పదకొండు లడ్డూలు మాయమైపోయాయా?",
  "cut": false
 },
 {
  "unit": 19,
  "start": 111.655,
  "end": 113.625,
  "hindi_on": 111.655,
  "hindi_off": 113.605,
  "dur": 1.97,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఏమైంది బామ్మ? ఏమైనా విశేషమా?",
  "cut": false
 },
 {
  "unit": 20,
  "start": 114.106,
  "end": 117.946,
  "hindi_on": 114.106,
  "hindi_off": 117.886,
  "dur": 3.84,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "చోటూ... నీ మూతికి ఈ పసుపు రంగు ఏంటి?",
  "cut": false
 },
 {
  "unit": 21,
  "start": 118.806,
  "end": 123.056,
  "hindi_on": 118.806,
  "hindi_off": 123.676,
  "dur": 4.25,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇదా? ఇది... నా కొత్త మీసం! మాస్టారు మీసం లాగా.",
  "cut": false
 },
 {
  "unit": 22,
  "start": 124.131,
  "end": 127.841,
  "hindi_on": 124.131,
  "hindi_off": 128.371,
  "dur": 3.71,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "నాకు కళ్లజోడు లేకపోతే ఏటి కనబడదు మరి.",
  "cut": false
 },
 {
  "unit": 23,
  "start": 129.302,
  "end": 133.782,
  "hindi_on": 129.302,
  "hindi_off": 133.532,
  "dur": 4.48,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "బామ్మ! నేను చూశాను! ఒక... ఒక మాయల లడ్డూ దొంగ వచ్చాడు!",
  "cut": false
 },
 {
  "unit": 24,
  "start": 134.066,
  "end": 135.796,
  "hindi_on": 134.066,
  "hindi_off": 136.496,
  "dur": 1.73,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "మాయల లడ్డూ దొంగా?",
  "cut": false
 },
 {
  "unit": 25,
  "start": 137.391,
  "end": 143.801,
  "hindi_on": 137.391,
  "hindi_off": 143.001,
  "dur": 6.42,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "అవును! ఎగురుతూ వచ్చాడు, కిటికీలోంచి. ఫుర్రున పళ్లెంలోకి దూకి, గప్-గప్ లడ్డూలన్నీ తినేశాడు!",
  "cut": false
 },
 {
  "unit": 26,
  "start": 143.93,
  "end": 147.13,
  "hindi_on": 143.93,
  "hindi_off": 147.58,
  "dur": 3.2,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "అవునా? మరి వాడు ఎలగ ఉండేవాడు?",
  "cut": false
 },
 {
  "unit": 27,
  "start": 148.027,
  "end": 153.067,
  "hindi_on": 148.027,
  "hindi_off": 152.777,
  "dur": 5.04,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "వాడు... వాడు... కనబడనేలేదు! మాయల దొంగ కదా, అందుకే!",
  "cut": false
 },
 {
  "unit": 28,
  "start": 153.7,
  "end": 156.51,
  "hindi_on": 153.7,
  "hindi_off": 156.17,
  "dur": 3.2,
  "tempo": 1.132,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "కానీ చోటూ, కిటికీ ఉదయం నుంచీ మూసే ఉంది.",
  "cut": false
 },
 {
  "unit": 29,
  "start": 156.647,
  "end": 160.757,
  "hindi_on": 156.647,
  "hindi_off": 160.087,
  "dur": 4.11,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "వాడు మూసిన కిటికీలోంచి కూడా దూరిపోతాడు! గాలిలాగా! ఫుర్రు!",
  "cut": false
 },
 {
  "unit": 30,
  "start": 161.059,
  "end": 163.779,
  "hindi_on": 161.059,
  "hindi_off": 164.189,
  "dur": 2.72,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "మరి నువ్వు ఆ వేళ ఎక్కడున్నావ్ రా, చోటూ?",
  "cut": false
 },
 {
  "unit": 31,
  "start": 164.656,
  "end": 169.486,
  "hindi_on": 164.656,
  "hindi_off": 169.036,
  "dur": 5.14,
  "tempo": 1.065,
  "drift": 0.0,
  "spill": 0.004,
  "early": 0.0,
  "text": "నేనా? నేనైతే... షేరూతో పడుకున్నాను! అవునా, షేరూ?",
  "cut": false
 },
 {
  "unit": 32,
  "start": 169.606,
  "end": 171.696,
  "hindi_on": 169.602,
  "hindi_off": 171.202,
  "dur": 2.09,
  "tempo": 1.0,
  "drift": 0.004,
  "spill": 0.0,
  "early": 0.0,
  "text": "చూశారా? షేరూ కూడా \"అవును\" అంటున్నాడు.",
  "cut": false
 },
 {
  "unit": 33,
  "start": 172.128,
  "end": 181.388,
  "hindi_on": 172.128,
  "hindi_off": 182.858,
  "dur": 9.26,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "అలా చోటూ మొదటి అబద్ధం మొదలైంది. పాపం వాడికి తెలీదు, అబద్ధం కూడా లడ్డూ లాంటిదే — ఒకటి తింటే, ఇంకొకటి కావాలంటుంది!",
  "cut": false
 },
 {
  "unit": 34,
  "start": 183.784,
  "end": 190.974,
  "hindi_on": 183.784,
  "hindi_off": 191.574,
  "dur": 7.19,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "స్నేహితులారా, సోంపూర్ లో ఒక మాయల లడ్డూ దొంగ తిరుగుతున్నాడు. సాయంత్రం పూజుంది. వాడిని పట్టుకోవాలి. పదా, ప్లాన్ వేద్దాం!",
  "cut": false
 },
 {
  "unit": 35,
  "start": 192.548,
  "end": 196.448,
  "hindi_on": 192.548,
  "hindi_off": 197.428,
  "dur": 3.9,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "నిజానికి, నేను పుస్తకంలో చదివాను, లడ్డూ దొంగలు మంగళవారమే వస్తారని.",
  "cut": false
 },
 {
  "unit": 36,
  "start": 198.376,
  "end": 200.176,
  "hindi_on": 198.376,
  "hindi_off": 200.306,
  "dur": 1.8,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "పింకీ, ఈరోజు బుధవారం కదా.",
  "cut": false
 },
 {
  "unit": 37,
  "start": 200.824,
  "end": 204.434,
  "hindi_on": 200.824,
  "hindi_off": 206.844,
  "dur": 3.61,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "అంటే... నిజానికి, వీడు ఓవర్ టైమ్ చేస్తూ ఉండాలి.",
  "cut": false
 },
 {
  "unit": 38,
  "start": 207.747,
  "end": 211.917,
  "hindi_on": 207.747,
  "hindi_off": 211.537,
  "dur": 4.78,
  "tempo": 1.147,
  "drift": 0.0,
  "spill": 0.003,
  "early": 0.0,
  "text": "మాయల దొంగా? కనబడడా? అంటే... దయ్యం!",
  "cut": false
 },
 {
  "unit": 39,
  "start": 212.037,
  "end": 214.927,
  "hindi_on": 212.034,
  "hindi_off": 214.754,
  "dur": 2.89,
  "tempo": 1.0,
  "drift": 0.003,
  "spill": 0.0,
  "early": 0.0,
  "text": "బబ్లూ అన్నయ్య, నా వెనుక మీరు అసలు పట్టరు!",
  "cut": false
 },
 {
  "unit": 40,
  "start": 215.716,
  "end": 223.316,
  "hindi_on": 215.716,
  "hindi_off": 221.546,
  "dur": 8.72,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.948,
  "early": 0.0,
  "text": "భయపడకండి! రాజు ది గ్రేట్ వచ్చేశాడు! ఏ దొంగ అయినా, ఈ వల పట్టుకుంటుంది.",
  "cut": false
 },
 {
  "unit": 41,
  "start": 223.436,
  "end": 226.306,
  "hindi_on": 222.488,
  "hindi_off": 228.838,
  "dur": 2.87,
  "tempo": 1.0,
  "drift": 0.948,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇది... ఇది ప్రాక్టీస్ అంతే. వల బాగానే పనిచేస్తోంది.",
  "cut": false
 },
 {
  "unit": 42,
  "start": 229.739,
  "end": 234.629,
  "hindi_on": 229.739,
  "hindi_off": 235.239,
  "dur": 4.89,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "చోటూ, నువ్వు దొంగని చూశావు కదా. చెప్పు, వాడికి ఇంకేమైనా గుర్తులు ఉన్నాయా?",
  "cut": false
 },
 {
  "unit": 43,
  "start": 235.761,
  "end": 239.081,
  "hindi_on": 235.761,
  "hindi_off": 238.301,
  "dur": 3.83,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.384,
  "early": 0.0,
  "text": "గుర్తులా? ఆ... వాడికి... ఒక నీలం తోక ఉంది!",
  "cut": false
 },
 {
  "unit": 44,
  "start": 239.201,
  "end": 240.921,
  "hindi_on": 238.817,
  "hindi_off": 240.827,
  "dur": 1.72,
  "tempo": 1.0,
  "drift": 0.384,
  "spill": 0.0,
  "early": 0.0,
  "text": "నీలం తోక. ఇంకా?",
  "cut": false
 },
 {
  "unit": 45,
  "start": 241.769,
  "end": 247.099,
  "hindi_on": 241.769,
  "hindi_off": 248.489,
  "dur": 5.33,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇంకా వాడు గుండ్రటి వస్తువులే తింటాడు. లడ్డూలు, పానీపూరీలు, బంతులు...",
  "cut": false
 },
 {
  "unit": 46,
  "start": 248.953,
  "end": 250.753,
  "hindi_on": 248.953,
  "hindi_off": 250.403,
  "dur": 2.03,
  "tempo": 1.126,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "బంతులా? నా క్రికెట్ బంతి!",
  "cut": false
 },
 {
  "unit": 47,
  "start": 250.876,
  "end": 255.806,
  "hindi_on": 250.876,
  "hindi_off": 255.096,
  "dur": 4.93,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇంకా వాడు తింటున్నప్పుడు, పాట పాడతాడు — \"లడ్డూ-లడ్డూ, గప్పూ-గప్పూ!\"",
  "cut": false
 },
 {
  "unit": 48,
  "start": 256.043,
  "end": 264.073,
  "hindi_on": 256.043,
  "hindi_off": 265.563,
  "dur": 8.03,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "వాడు గుండ్రటివి తింటే, మనం గుండ్రటి దాంతోనే పట్టుకుందాం. లల్లన్ మావయ్య దగ్గర లడ్డూలు తెచ్చి, రావి చెట్టు కింద పెట్టి, పైన వల వేద్దాం!",
  "cut": false
 },
 {
  "unit": 49,
  "start": 266.045,
  "end": 269.925,
  "hindi_on": 266.045,
  "hindi_off": 269.715,
  "dur": 3.88,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "సూపర్ ప్లాన్! కానీ ముందు నన్ను ఈ వలలోంచి బయటికి తీయండి.",
  "cut": false
 },
 {
  "unit": 50,
  "start": 273.624,
  "end": 283.974,
  "hindi_on": 273.624,
  "hindi_off": 282.874,
  "dur": 11.42,
  "tempo": 1.105,
  "drift": 0.0,
  "spill": 0.017,
  "early": 0.0,
  "text": "చూశారా? ఒక అబద్ధం నీలం తోకైంది, తోక పాటైంది. చోటూ అబద్ధం ఇప్పుడు రావి చెట్టు కంటే పొడవుగా పెరుగుతోంది.",
  "cut": false
 },
 {
  "unit": 51,
  "start": 284.094,
  "end": 291.224,
  "hindi_on": 284.077,
  "hindi_off": 290.477,
  "dur": 8.19,
  "tempo": 1.15,
  "drift": 0.017,
  "spill": 0.371,
  "early": 0.0,
  "text": "అయ్యో నా గుండ్రటి పిల్లలారా! ఎండలో కూర్చోకండి, నల్లగా అయిపోతారు. రండి, పాకంలో మునకలేయండి.",
  "cut": false
 },
 {
  "unit": 52,
  "start": 291.344,
  "end": 296.114,
  "hindi_on": 290.973,
  "hindi_off": 296.043,
  "dur": 4.77,
  "tempo": 1.0,
  "drift": 0.371,
  "spill": 0.0,
  "early": 0.0,
  "text": "లల్లన్ మావయ్యా, మాకు నాలుగు లడ్డూలు కావాలి. మేము మాయల లడ్డూ దొంగకి వల వేస్తున్నాం.",
  "cut": false
 },
 {
  "unit": 53,
  "start": 296.978,
  "end": 300.528,
  "hindi_on": 296.978,
  "hindi_off": 300.938,
  "dur": 3.55,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఏంటి? లడ్డూ దొంగా? మన ఊరిలోనా?",
  "cut": false
 },
 {
  "unit": 54,
  "start": 301.394,
  "end": 307.834,
  "hindi_on": 301.394,
  "hindi_off": 307.034,
  "dur": 7.31,
  "tempo": 1.137,
  "drift": 0.0,
  "spill": 0.012,
  "early": 0.0,
  "text": "వద్దు! నా పిల్లల జోలికి ఎవరూ రాకూడదు! జిలేబీ రాణి, భయపడకు, మావయ్య ఉన్నాడుగా!",
  "cut": false
 },
 {
  "unit": 55,
  "start": 307.954,
  "end": 311.054,
  "hindi_on": 307.942,
  "hindi_off": 310.692,
  "dur": 3.45,
  "tempo": 1.107,
  "drift": 0.012,
  "spill": 0.0,
  "early": 0.0,
  "text": "కంగారుపడకండి మావయ్యా. రాజు ది గ్రేట్ ఉన్నాడుగా.",
  "cut": false
 },
 {
  "unit": 56,
  "start": 311.191,
  "end": 316.381,
  "hindi_on": 311.191,
  "hindi_off": 315.991,
  "dur": 5.19,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇది... ఇది కూడా ప్లాన్ లో భాగమే. చెయ్యి తియ్యగా ఉంటే, దొంగ దగ్గరికి వస్తాడు.",
  "cut": false
 },
 {
  "unit": 57,
  "start": 316.964,
  "end": 325.624,
  "hindi_on": 316.964,
  "hindi_off": 325.244,
  "dur": 8.89,
  "tempo": 1.025,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇదిగో నాలుగు లడ్డూలు. జాగ్రత్తగా చూసుకోండి. ఇవి నా చాలా మంచోళ్లు. ఎప్పుడూ మూకుడు దాటి బయట పడవు.",
  "cut": false
 },
 {
  "unit": 58,
  "start": 325.759,
  "end": 329.099,
  "hindi_on": 325.759,
  "hindi_off": 328.549,
  "dur": 3.34,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఖచ్చితంగా మావయ్యా. దొంగ దొరగ్గానే తిరిగితెచ్చేస్తాం.",
  "cut": false
 },
 {
  "unit": 59,
  "start": 329.516,
  "end": 331.766,
  "hindi_on": 329.516,
  "hindi_off": 331.536,
  "dur": 2.25,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "మావయ్యా, నాకు ఆకలేస్తోంది!",
  "cut": false
 },
 {
  "unit": 60,
  "start": 332.013,
  "end": 334.513,
  "hindi_on": 332.013,
  "hindi_off": 334.863,
  "dur": 2.5,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "చోటూ! ఇవి దొంగ కోసం, నీ కోసం కాదు!",
  "cut": false
 },
 {
  "unit": 61,
  "start": 335.78,
  "end": 342.48,
  "hindi_on": 335.78,
  "hindi_off": 342.15,
  "dur": 7.28,
  "tempo": 1.086,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ప్లాన్ ఏంటంటే — దొంగ లడ్డూ తినడానికి రాగానే, నేను తాడు లాగుతాను, వల పడుతుంది, దొంగ దొరికిపోతాడు!",
  "cut": false
 },
 {
  "unit": 62,
  "start": 342.604,
  "end": 350.094,
  "hindi_on": 342.604,
  "hindi_off": 347.354,
  "dur": 8.6,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 2.335,
  "early": 0.0,
  "text": "గుడియా, కానీ దొంగ కనబడడు కదా. వల పడ్డా లోపల ఎవడైనా ఉన్నాడో లేదో ఎలా తెలుస్తుంది?",
  "cut": false
 },
 {
  "unit": 63,
  "start": 350.214,
  "end": 352.894,
  "hindi_on": 347.879,
  "hindi_off": 352.099,
  "dur": 3.02,
  "tempo": 1.128,
  "drift": 2.335,
  "spill": 0.002,
  "early": 0.0,
  "text": "అదీ... అంటే... ప్లాన్ లో ఈ భాగాన్ని రేపు ఆలోచిస్తాను.",
  "cut": false
 },
 {
  "unit": 64,
  "start": 353.014,
  "end": 356.304,
  "hindi_on": 353.012,
  "hindi_off": 355.972,
  "dur": 3.68,
  "tempo": 1.114,
  "drift": 0.002,
  "spill": 0.0,
  "early": 0.0,
  "text": "వినండి! కొరుకుతున్న శబ్దం! దొంగ వచ్చేశాడు!",
  "cut": false
 },
 {
  "unit": 65,
  "start": 356.436,
  "end": 359.896,
  "hindi_on": 356.436,
  "hindi_off": 359.056,
  "dur": 3.47,
  "tempo": 1.006,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "పట్టుకున్నా! రాజు ది గ్రేట్ దొంగని పట్టుకున్నాడు!",
  "cut": false
 },
 {
  "unit": 66,
  "start": 360.016,
  "end": 365.666,
  "hindi_on": 360.006,
  "hindi_off": 365.256,
  "dur": 5.75,
  "tempo": 1.019,
  "drift": 0.01,
  "spill": 0.01,
  "early": 0.0,
  "text": "నిజానికి... దొంగ తోక నీలం కాదు, గోధుమ రంగు. ఇది మొరుగుతోంది కూడా.",
  "cut": false
 },
 {
  "unit": 67,
  "start": 365.786,
  "end": 368.436,
  "hindi_on": 365.776,
  "hindi_off": 368.306,
  "dur": 2.65,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "పింకీ, వీడు దొంగ కాదు, షేరూ!",
  "cut": false
 },
 {
  "unit": 68,
  "start": 369.245,
  "end": 371.045,
  "hindi_on": 369.245,
  "hindi_off": 371.405,
  "dur": 1.8,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "దయ్యం! దయ్యం!",
  "cut": false
 },
 {
  "unit": 69,
  "start": 371.886,
  "end": 379.246,
  "hindi_on": 371.886,
  "hindi_off": 377.846,
  "dur": 8.46,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.587,
  "early": 0.0,
  "text": "ఓయ్ గుంటలారా, నేనేనే. నా కళ్లజోడు వెతుకుతున్నాను. ఎవరైనా చూసారేటి?",
  "cut": false
 },
 {
  "unit": 70,
  "start": 379.366,
  "end": 387.726,
  "hindi_on": 378.779,
  "hindi_off": 388.259,
  "dur": 8.36,
  "tempo": 1.0,
  "drift": 0.587,
  "spill": 0.0,
  "early": 0.0,
  "text": "పిల్లలు! నేను కూడా వచ్చేశాను! దొంగ గాని నా జిలేబీల దగ్గరికి వస్తే, ఈ అప్పడాల కర్ర... వాడికి బాగా బుద్ధి చెప్తుంది!",
  "cut": false
 },
 {
  "unit": 71,
  "start": 389.157,
  "end": 392.317,
  "hindi_on": 389.157,
  "hindi_off": 391.557,
  "dur": 3.16,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "మావయ్యా, మాకు దొంగ దొరకనే లేదు.",
  "cut": false
 },
 {
  "unit": 72,
  "start": 392.501,
  "end": 396.861,
  "hindi_on": 392.501,
  "hindi_off": 398.211,
  "dur": 4.36,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "వాడు... వాడు ఇప్పుడు లల్లన్ మావయ్య కొట్టు వైపు వెళ్ళుంటాడు! నేను వాడి నీలం తోక అటు వెళ్లడం చూశాను!",
  "cut": false
 },
 {
  "unit": 73,
  "start": 398.707,
  "end": 404.207,
  "hindi_on": 398.707,
  "hindi_off": 404.167,
  "dur": 5.5,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "అయ్యో! నా జిలేబీలు ఒంటరిగా ఉన్నాయి! వచ్చెస్తున్నాను నా పిల్లలారా!",
  "cut": false
 },
 {
  "unit": 74,
  "start": 405.062,
  "end": 411.732,
  "hindi_on": 405.062,
  "hindi_off": 412.012,
  "dur": 6.67,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇక నేను రాత్రి నిద్రపోలేను. నీలం తోక దయ్యం పాట పాడుతుంది, \"లడ్డూ-లడ్డూ, గప్పూ-గప్పూ\"...",
  "cut": false
 },
 {
  "unit": 75,
  "start": 412.512,
  "end": 420.812,
  "hindi_on": 412.512,
  "hindi_off": 420.312,
  "dur": 8.3,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "నా నడుము నొప్పి! రాజు ది గ్రేట్ ఈరోజు మూడు సార్లు పడ్డాడు. ఈ దొంగ చాలా ప్రమాదకారి.",
  "cut": false
 },
 {
  "unit": 76,
  "start": 421.231,
  "end": 427.411,
  "hindi_on": 421.231,
  "hindi_off": 428.671,
  "dur": 6.18,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "పూజకి లడ్డూలు కూడా లేవు. బామ్మ ఎంత బాధపడుతోందో. ఈసారి పూజ పూర్తి కాదేమో అని అంటోంది.",
  "cut": false
 },
 {
  "unit": 77,
  "start": 429.182,
  "end": 435.382,
  "hindi_on": 429.182,
  "hindi_off": 434.572,
  "dur": 6.65,
  "tempo": 1.074,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "పర్లేదు. రేపు ఉదయం మళ్లీ కొత్త ప్లాన్ వేద్దాం. దొంగ దొరికేదాకా రాత్రంతా మెలకువగానే ఉందాం!",
  "cut": false
 },
 {
  "unit": 78,
  "start": 435.502,
  "end": 443.842,
  "hindi_on": 435.496,
  "hindi_off": 442.906,
  "dur": 8.34,
  "tempo": 1.0,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "చోటూ కడుపు అయితే నిండింది. కానీ ఇప్పుడు వాడి మనసులో ఏదో బరువుగా అనిపిస్తోంది. లడ్డూ కంటే బరువుగా.",
  "cut": false
 },
 {
  "unit": 80,
  "start": 445.479,
  "end": 448.869,
  "hindi_on": 445.479,
  "hindi_off": 448.649,
  "dur": 3.39,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "వద్దు చమ్కీ, వద్దు! అది నా తర్వాత ఆకలి కోసం!",
  "cut": false
 },
 {
  "unit": 81,
  "start": 449.606,
  "end": 453.026,
  "hindi_on": 449.606,
  "hindi_off": 453.756,
  "dur": 3.42,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "చోటూ... ఇది బామ్మ చేసిన లడ్డూ కదా.",
  "cut": false
 },
 {
  "unit": 82,
  "start": 454.208,
  "end": 457.198,
  "hindi_on": 454.208,
  "hindi_off": 456.858,
  "dur": 3.21,
  "tempo": 1.076,
  "drift": 0.0,
  "spill": 0.007,
  "early": 0.0,
  "text": "అంటే నీలం తోక దొంగ...",
  "cut": false
 },
 {
  "unit": 83,
  "start": 457.318,
  "end": 461.928,
  "hindi_on": 457.311,
  "hindi_off": 462.341,
  "dur": 4.61,
  "tempo": 1.0,
  "drift": 0.007,
  "spill": 0.0,
  "early": 0.0,
  "text": "నిజానికి... దొంగకి ఉంది తోక కాదు, జేబు!",
  "cut": false
 },
 {
  "unit": 84,
  "start": 463.315,
  "end": 477.865,
  "hindi_on": 463.315,
  "hindi_off": 475.275,
  "dur": 16.71,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.695,
  "early": 0.0,
  "text": "అవును! నేనే లడ్డూలన్నీ తినేశాను! ఏ మాయల దొంగా లేడు. నీలం తోకా లేదు, పాటా లేదు. నాకు ఆకలేసింది, తరవాత భయమేసింది, అందుకే అబద్ధాలు చెప్తూ వచ్చాను... క్షమించండి! అందరూ క్షమించండి!",
  "cut": false
 },
 {
  "unit": 85,
  "start": 477.985,
  "end": 481.045,
  "hindi_on": 476.29,
  "hindi_off": 477.91,
  "dur": 3.51,
  "tempo": 1.15,
  "drift": 1.695,
  "spill": 2.847,
  "early": 0.0,
  "text": "అంటే... దయ్యం ఏమీ లేదా?",
  "cut": false
 },
 {
  "unit": 86,
  "start": 481.165,
  "end": 484.315,
  "hindi_on": 478.318,
  "hindi_off": 483.588,
  "dur": 3.53,
  "tempo": 1.126,
  "drift": 2.847,
  "spill": 0.014,
  "early": 0.0,
  "text": "లేదు బబ్లూ అన్నయ్యా. దయ్యం లేదు. నేనే.",
  "cut": false
 },
 {
  "unit": 87,
  "start": 484.435,
  "end": 489.235,
  "hindi_on": 484.421,
  "hindi_off": 488.441,
  "dur": 5.4,
  "tempo": 1.128,
  "drift": 0.014,
  "spill": 0.013,
  "early": 0.0,
  "text": "అబ్బా! థాంక్యూ చోటూ! ఇప్పుడు నేను హాయిగా నిద్రపోతాను!",
  "cut": false
 },
 {
  "unit": 88,
  "start": 489.355,
  "end": 494.165,
  "hindi_on": 489.342,
  "hindi_off": 493.782,
  "dur": 5.1,
  "tempo": 1.061,
  "drift": 0.013,
  "spill": 0.005,
  "early": 0.0,
  "text": "బామ్మ, లడ్డూలు నేనే తిన్నాను. ఆపై అబద్ధం చెప్పాను. నన్ను క్షమించు.",
  "cut": false
 },
 {
  "unit": 89,
  "start": 494.285,
  "end": 496.845,
  "hindi_on": 494.28,
  "hindi_off": 496.47,
  "dur": 2.85,
  "tempo": 1.112,
  "drift": 0.005,
  "spill": 0.0,
  "early": 0.0,
  "text": "నాకు తెలుసులే రా, చోటూ.",
  "cut": false
 },
 {
  "unit": 90,
  "start": 496.969,
  "end": 499.559,
  "hindi_on": 496.969,
  "hindi_off": 499.189,
  "dur": 2.59,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "తెలుసా? మరి నీ కళ్లజోడు...",
  "cut": false
 },
 {
  "unit": 91,
  "start": 500.061,
  "end": 510.921,
  "hindi_on": 500.061,
  "hindi_off": 511.311,
  "dur": 10.86,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "కళ్లజోడు లేకపోతే ఏటి, ముక్కు ఉన్నాదిగా. నీ మూతి నుంచి శనగపిండి వాసన వస్తున్నాది. నువ్వే సొంతంగా నిజం సెప్తావని చూత్తున్నాను.",
  "cut": false
 },
 {
  "unit": 92,
  "start": 511.796,
  "end": 516.006,
  "hindi_on": 511.796,
  "hindi_off": 515.246,
  "dur": 4.27,
  "tempo": 1.012,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇక ఎప్పుడూ అబద్ధం చెప్పను బామ్మ. అబద్ధం బాగా అలసిపోయేలా చేస్తుంది!",
  "cut": false
 },
 {
  "unit": 93,
  "start": 516.135,
  "end": 521.735,
  "hindi_on": 516.135,
  "hindi_off": 522.795,
  "dur": 5.6,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "పదండి, అందరం కలిసి కొత్త లడ్డూలు సేద్దాం. పూజకి ఇంకా టైము ఉన్నాది.",
  "cut": false
 },
 {
  "unit": 94,
  "start": 523.297,
  "end": 527.257,
  "hindi_on": 523.297,
  "hindi_off": 526.997,
  "dur": 4.52,
  "tempo": 1.142,
  "drift": 0.0,
  "spill": 0.002,
  "early": 0.0,
  "text": "అంటే ఇక నేను వల పట్టుకుని కింద పడక్కర్లేదా?",
  "cut": false
 },
 {
  "unit": 95,
  "start": 527.377,
  "end": 530.407,
  "hindi_on": 527.375,
  "hindi_off": 534.465,
  "dur": 3.03,
  "tempo": 1.0,
  "drift": 0.002,
  "spill": 0.0,
  "early": 0.0,
  "text": "లేదు రాజు, ఇప్పుడు సనగపిండి కలపడమే.",
  "cut": false
 },
 {
  "unit": 96,
  "start": 535.402,
  "end": 540.322,
  "hindi_on": 535.402,
  "hindi_off": 541.172,
  "dur": 4.92,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "పదా, ప్లాన్ వేద్దాం! లడ్డూలు చేసే ప్లాన్! ఈసారి ప్లాన్ లో ఎలాంటి లోపం ఉండదు!",
  "cut": false
 },
 {
  "unit": 97,
  "start": 541.676,
  "end": 545.886,
  "hindi_on": 541.676,
  "hindi_off": 545.906,
  "dur": 4.21,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "నిజానికి, గుడియా, నీ ప్రతి ప్లాన్ లోనూ ఒక లోపం ఉంటుంది.",
  "cut": false
 },
 {
  "unit": 98,
  "start": 546.419,
  "end": 549.239,
  "hindi_on": 546.419,
  "hindi_off": 548.139,
  "dur": 3.22,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.241,
  "early": 0.0,
  "text": "అయితే ఈసారి ఆ లోపంలో శనగపిండి నింపేద్దాం!",
  "cut": false
 },
 {
  "unit": 99,
  "start": 549.359,
  "end": 554.339,
  "hindi_on": 549.118,
  "hindi_off": 553.338,
  "dur": 5.71,
  "tempo": 1.15,
  "drift": 0.241,
  "spill": 0.675,
  "early": 0.0,
  "text": "ఇక అప్పుడు మొదలైంది సోంపూర్ లోనే అత్యంత సరదా లడ్డూల ఫ్యాక్టరీ!",
  "cut": false
 },
 {
  "unit": 100,
  "start": 554.459,
  "end": 559.749,
  "hindi_on": 553.784,
  "hindi_off": 557.664,
  "dur": 6.09,
  "tempo": 1.15,
  "drift": 0.675,
  "spill": 1.307,
  "early": 0.0,
  "text": "నిజానికి, లడ్డూలు చతురస్రంగా చేయాలి. అవి ఎక్కువ సేపు నిలుస్తాయి.",
  "cut": false
 },
 {
  "unit": 101,
  "start": 559.869,
  "end": 564.909,
  "hindi_on": 558.562,
  "hindi_off": 566.042,
  "dur": 5.04,
  "tempo": 1.0,
  "drift": 1.307,
  "spill": 0.0,
  "early": 0.0,
  "text": "పింకీ అమ్మడూ, లడ్డూలు గుండ్రంగానే బాగుంటాయి. ఇలగ చుట్టాలి, చూడు.",
  "cut": false
 },
 {
  "unit": 102,
  "start": 566.512,
  "end": 571.092,
  "hindi_on": 566.512,
  "hindi_off": 571.252,
  "dur": 4.58,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "చూడండి, రాజు ది గ్రేట్ సూపరు లడ్డూ! అందరికంటే పెద్దది!",
  "cut": false
 },
 {
  "unit": 103,
  "start": 572.23,
  "end": 574.94,
  "hindi_on": 572.23,
  "hindi_off": 575.12,
  "dur": 2.71,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇది... ఇది పొడి లడ్డూ. కొత్త డిజైన్.",
  "cut": false
 },
 {
  "unit": 104,
  "start": 576.068,
  "end": 578.238,
  "hindi_on": 576.068,
  "hindi_off": 577.928,
  "dur": 2.17,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "నా లడ్డూలు భలే గుండ్రంగా వచ్చాయి!",
  "cut": false
 },
 {
  "unit": 106,
  "start": 580.032,
  "end": 583.712,
  "hindi_on": 580.032,
  "hindi_off": 581.852,
  "dur": 4.23,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.502,
  "early": 0.0,
  "text": "దయ్యం! నా లడ్డూని దయ్యం తీసుకెళ్లిపోయింది!",
  "cut": false
 },
 {
  "unit": 107,
  "start": 583.832,
  "end": 585.392,
  "hindi_on": 582.33,
  "hindi_off": 584.51,
  "dur": 1.77,
  "tempo": 1.15,
  "drift": 1.502,
  "spill": 0.041,
  "early": 0.0,
  "text": "బబ్లూ, అది చమ్కీ!",
  "cut": false
 },
 {
  "unit": 108,
  "start": 585.512,
  "end": 588.602,
  "hindi_on": 585.471,
  "hindi_off": 588.171,
  "dur": 3.51,
  "tempo": 1.147,
  "drift": 0.041,
  "spill": 0.03,
  "early": 0.0,
  "text": "కడుపు బాబాయ్, ఇవి పూజ లడ్డూలు. కాస్త ఓపిక పట్టు!",
  "cut": false
 },
 {
  "unit": 109,
  "start": 588.722,
  "end": 593.532,
  "hindi_on": 588.692,
  "hindi_off": 592.002,
  "dur": 5.53,
  "tempo": 1.15,
  "drift": 0.03,
  "spill": 0.691,
  "early": 0.0,
  "text": "వాహ్ చోటూ! ఈరోజు నువ్వు నిజంగా పెద్దవాడివయ్యావు.",
  "cut": false
 },
 {
  "unit": 110,
  "start": 593.652,
  "end": 600.432,
  "hindi_on": 592.961,
  "hindi_off": 599.631,
  "dur": 7.78,
  "tempo": 1.148,
  "drift": 0.691,
  "spill": 0.001,
  "early": 0.0,
  "text": "నా జిలేబీలు క్షేమంగా ఉన్నాయి! దొంగ రానేలేదు. ఈ ఆనందంలో పూజకి ఈ జిలేబీలు నా తరఫు కానుక!",
  "cut": false
 },
 {
  "unit": 111,
  "start": 600.552,
  "end": 606.262,
  "hindi_on": 600.551,
  "hindi_off": 607.191,
  "dur": 5.71,
  "tempo": 1.0,
  "drift": 0.001,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఇక అందరికీ ప్రసాదం. మొదటి లడ్డూ... నిజం సెప్పిన చోటూకే!",
  "cut": false
 },
 {
  "unit": 112,
  "start": 607.703,
  "end": 615.233,
  "hindi_on": 607.703,
  "hindi_off": 614.433,
  "dur": 8.64,
  "tempo": 1.148,
  "drift": 0.0,
  "spill": 0.003,
  "early": 0.0,
  "text": "అబద్ధం లడ్డూ కడుపులో బరువుగా అనిపించేది. నిజం లడ్డూ చాలా తేలికగా, తియ్యగా ఉంది!",
  "cut": false
 },
 {
  "unit": 113,
  "start": 615.353,
  "end": 619.953,
  "hindi_on": 615.35,
  "hindi_off": 621.51,
  "dur": 4.6,
  "tempo": 1.0,
  "drift": 0.003,
  "spill": 0.0,
  "early": 0.0,
  "text": "నిజం సెప్పేటోళ్ల మనసు కూడా లడ్డూలాగే తియ్యగా ఉంటాది.",
  "cut": false
 },
 {
  "unit": 114,
  "start": 622.017,
  "end": 626.337,
  "hindi_on": 622.017,
  "hindi_off": 626.387,
  "dur": 4.32,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "చూడండి, షేరూ లేచాడు! తినే సమయానికి ఎప్పుడూ లేచేస్తాడు!",
  "cut": false
 },
 {
  "unit": 115,
  "start": 627.297,
  "end": 631.287,
  "hindi_on": 627.297,
  "hindi_off": 630.917,
  "dur": 3.99,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ఓలమ్మో, నా కళ్లజోడు మళ్లీ ఎక్కడికెళ్ళిందో?",
  "cut": false
 },
 {
  "unit": 116,
  "start": 631.431,
  "end": 634.621,
  "hindi_on": 631.431,
  "hindi_off": 634.231,
