  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ছোটু... এইটো দেখোন আইতাৰ সেই লাৰুটো।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
