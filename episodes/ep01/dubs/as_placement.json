  "hindi_off": 404.167,
  "dur": 4.78,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "হায় হায়! মোৰ জিলেপীহঁত অকলে আছে! মই গৈছোঁ ৰ’ মোৰ পোনাটিহঁত!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
