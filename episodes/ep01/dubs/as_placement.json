  "hindi_off": 296.043,
  "dur": 5.63,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "লল্লন খুড়া, আমাক চাৰিটা লাৰু লাগে। আমি যাদুৰ লাৰুচোৰটো ধৰিবলৈ ফান্দ পাতিছোঁ।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
