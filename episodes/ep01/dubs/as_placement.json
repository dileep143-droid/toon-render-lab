  "drift": 0.237,
  "spill": 0.0,
  "early": 0.0,
  "text": "নাই, বাবলু ককাইদেউ। ভূত নাই। কেৱল মইহে।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
