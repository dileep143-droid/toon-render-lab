  "tempo": 1.0,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "আহা... কি যে ধুনীয়া গোন্ধ! আইতা, মোৰ ভোক লাগিছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
