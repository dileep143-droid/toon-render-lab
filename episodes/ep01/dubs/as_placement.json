  "dur": 2.51,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "বুজি পালোঁ, আইতা! হাত নিদিওঁ।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
