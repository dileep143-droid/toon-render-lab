  "dur": 4.51,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আৰু সি কেৱল ঘূৰণীয়া বস্তুবোৰহে খায়। লাৰু, ফুচকা, বল...",
  "reused_from": null,
