  "tempo": 1.0,
  "drift": 0.457,
  "spill": 0.0,
  "early": 0.0,
  "text": "আৰু সি খাওঁতে খাওঁতে গান গায়—\"লাৰু-লাৰু, গাপ্পু-গাপ্পু!\"",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
