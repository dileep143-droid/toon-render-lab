  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "চমকী, তইয়ো নক’ৱ। বাৰু, মই অলপ জিৰাই লওঁ।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
