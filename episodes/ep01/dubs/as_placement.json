  "hindi_off": 428.671,
  "dur": 7.65,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আৰু পূজাৰ বাবে লাৰুও নাই। আইতাৰ বৰ মনটো বেয়া লাগিছে। তেখেতে কৈছিল, এইবাৰ পূজাখন আধৰুৱা হৈ ৰ’ব।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
