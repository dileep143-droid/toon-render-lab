  "dur": 8.67,
  "tempo": 1.049,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "এই লাৰুগিলা ভগৱানক দিম। পূজাৰ পাছতহে সৱে পাবা। তেতিয়ালৈকে কোনেও হাত নিদিবা। বুজি পালা?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
