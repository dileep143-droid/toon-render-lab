  "start": 405.062,
  "end": 412.392,
  "hindi_on": 405.062,
  "hindi_off": 412.012,
  "dur": 7.35,
  "tempo": 1.003,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "এতিয়া মই ৰাতি শুবও নোৱাৰিম। নীলা নেজ থকা ভূতে গান গাব, \"লাৰু-লাৰু, গাপ্পু-গাপ্পু\"...",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
