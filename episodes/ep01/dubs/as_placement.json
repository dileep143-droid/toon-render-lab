  "hindi_on": 429.182,
  "hindi_off": 434.572,
  "dur": 6.1,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "একো কথা নাই। কাইলৈ ৰাতিপুৱা নতুন আঁচনি বনাম। চোৰ নোপোৱালৈকে আমি গোটেই ৰাতি উজাগৰে থাকিম!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 78,
