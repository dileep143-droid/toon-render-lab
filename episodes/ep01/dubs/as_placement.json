  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ঐ মোৰ ঘূৰণীয়া পোনাটিহঁত! ৰ’দত নাথাকিবি, ক’লা পৰি যাবি। আহাঁ, চিৰাত ডুবি ল’।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
