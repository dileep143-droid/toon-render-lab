  "dur": 2.99,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "সেইটো ৰাতিপুৱাৰ ভোক আছিল। এইটো এতিয়াৰ ভোক।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
