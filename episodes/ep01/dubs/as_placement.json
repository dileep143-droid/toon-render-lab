  "drift": 0.0,
  "spill": 0.007,
  "early": 0.0,
  "text": "চুউপ, পেট মহাশয়! মনে মনে থাকা! আইতা সাৰ পাব।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
