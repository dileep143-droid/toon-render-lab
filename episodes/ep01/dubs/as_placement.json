  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ভয় নকৰিবা! ৰাজু দ্য গ্ৰেট আহি গ’ল! যেনেকুৱাই চোৰ নহওক, এইখন জালে তাক ধৰিবই।",
  "reused_from": null,
  "spoken_text": null,
