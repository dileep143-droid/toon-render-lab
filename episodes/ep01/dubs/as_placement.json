  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.457,
  "early": 0.0,
  "text": "বলো খায়? মোৰ ক্ৰিকেট বলটো!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
