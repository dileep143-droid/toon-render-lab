  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "দুপৰীয়া হ’ল। আইতা শুলে। শেৰুও শুলে। কিন্তু সৰু ছোটুৰ পেটটো... মুঠেই নুশুলে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
