  "dur": 3.53,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "নহয় চমকী, নহয়! সেইটো মোৰ পিছত লগা ভোকৰ কাৰণেহে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
