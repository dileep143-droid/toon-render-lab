  "end": 442.866,
  "hindi_on": 435.496,
  "hindi_off": 442.906,
  "dur": 7.37,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ছোটুৰ পেটটো ভৰি আছিল সঁচা। কিন্তু এতিয়া তাৰ মনটো বৰ গধুৰ লাগিছিল। লাৰুতকৈও বেছি গধুৰ।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
