  "dur": 9.03,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "যদি সি ঘূৰণীয়া বস্তু খায়, তেন্তে আমি তাক ঘূৰণীয়া বস্তুৰেই ফান্দত পেলাম। লল্লন খুড়াৰ পৰা লাৰু আনোঁ, আঁহত গছৰ তলত থওঁ, আৰু ওপৰত জাল পাতোঁ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
