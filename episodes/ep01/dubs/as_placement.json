  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "বাবলু ককাইদেউ, মোৰ পিছে পিছে আপুনি নোজোৰে দেই!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
