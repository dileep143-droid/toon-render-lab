  "dur": 3.1,
  "tempo": 1.0,
  "drift": 0.007,
  "spill": 0.0,
  "early": 0.0,
  "text": "আচলতে... চোৰৰ নেজ নহয়, জেপহে আছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
