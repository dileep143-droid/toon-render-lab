  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "এইটো... এইটো অনুশীলনহে আছিল। জালে ঠিকেই কাম কৰিছে।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
