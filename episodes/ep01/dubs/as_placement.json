  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "বঢ়িয়া প্লেন! কিন্তু প্ৰথমে কোনোবাই মোক জালৰ পৰা উলিওৱাচোন।",
  "reused_from": null,
