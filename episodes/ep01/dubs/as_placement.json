  "dur": 13.18,
  "tempo": 1.025,
  "drift": 0.0,
  "spill": 0.005,
  "early": 0.0,
  "text": "হয়! ময়েই সৱ লাৰু খাই দিলোঁ! কোনো যাদুৰ চোৰ নাই। নীলা নেজো নাই, গানো নাই। মোৰ ভোক লাগিছিল, তাৰপাছত ভয় লাগিল, আৰু এটাৰ পিছত এটা মিছা ক’লোঁ... মোক ক্ষমা কৰি দিয়া! সকলোৱে ক্ষমা কৰা!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
