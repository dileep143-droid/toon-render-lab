  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "এইমাত্ৰ তুঁই চাৰিখন পৰঠা খালাক নহয়, ছোটু!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
