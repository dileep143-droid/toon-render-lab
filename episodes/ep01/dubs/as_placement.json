  "tempo": 1.083,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "এক, দুই, তিনি... এঘাৰটা লাৰু! বাছ, পূজাৰ বাবে হৈ গেলাক।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
