  "hindi_off": 420.312,
  "dur": 5.78,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আৰু মোৰ কঁকালখন! ৰাজু দ্য গ্ৰেট আজি তিনিবাৰকৈ পৰিল। চোৰটো বৰ সাংঘাটিক দেই।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
