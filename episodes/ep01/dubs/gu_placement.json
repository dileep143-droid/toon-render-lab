  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "હમણે જ તો તેં ચાર પરોઠા ખાધા'તા, છોટુ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
