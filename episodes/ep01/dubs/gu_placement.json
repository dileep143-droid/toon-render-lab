  "dur": 2.05,
  "tempo": 1.0,
  "drift": 0.005,
  "spill": 0.0,
  "early": 0.0,
  "text": "સમજી ગયો, બા! હાથ નહીં અડાડું.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
