  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "એ તો સવારની ભૂખ હતી. આ અત્યારની ભૂખ છે.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
