  "dur": 2.01,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "જોયું? શેરુ પણ \"હા\" પાડે છે.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
