  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "આહા... કેવી મસ્ત સુગંધ! દાદી, મને ભૂખ લાગી છે!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
