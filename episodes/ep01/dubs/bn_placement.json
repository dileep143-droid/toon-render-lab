  "tempo": 1.15,
  "drift": 1.234,
  "spill": 1.322,
  "early": 0.0,
  "text": "\"ব্যস একটা\" বলতে বলতে ছোটু আর গোনাগুনতিই রাখল না।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
