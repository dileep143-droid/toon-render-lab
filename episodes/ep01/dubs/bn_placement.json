  "hindi_off": 95.487,
  "dur": 2.49,
  "tempo": 1.15,
  "drift": 1.322,
  "spill": 0.144,
  "early": 0.0,
  "text": "এটা পরের জন্য। পরের বারের খিদের জন্য!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
