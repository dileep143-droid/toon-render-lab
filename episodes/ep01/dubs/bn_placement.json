  "hindi_on": 284.077,
  "hindi_off": 290.477,
  "dur": 6.95,
  "tempo": 1.026,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আরে আমার গোল গোল সোনার টুকরোরা! রোদে বোসো না, কালো হয়ে যাবে। চলো, রসে একটু ডুব দিয়ে নাও।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 52,
  "start": 290.973,
  "end": 296.193,
  "hindi_on": 290.973,
  "hindi_off": 296.043,
  "dur": 5.22,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "লল্লন কাকু, আমাদের চারটে লাড্ডু দিন না। আমরা জাদুকরী লাড্ডু চোর ধরার জন্য ফাঁদ পাতছি।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
