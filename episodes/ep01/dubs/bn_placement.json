  "spill": 0.0,
  "early": 0.0,
  "text": "হায় হায়! আমার জিলিপিগুলো একা একা রয়েছে! আমি আসছি বাছারা!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
