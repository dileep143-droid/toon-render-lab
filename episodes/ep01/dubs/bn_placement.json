  "spill": 0.097,
  "early": 0.0,
  "text": "আরে পোলাপান, আমি গো। চশমাখান খুঁজতে আছিলাম। কেউ দেখসো নাকি?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
