  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "কিন্তু গুড়িয়া, চোরকে তো দেখাই যায় না। জাল পড়লে কী করে বুঝবি ভেতরে কেউ আছে?",
  "reused_from": null,
