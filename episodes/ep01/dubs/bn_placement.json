  "tempo": 1.15,
  "drift": 0.123,
  "spill": 0.38,
  "early": 0.0,
  "text": "এটা... এটাও প্ল্যানের অঙ্গ। হাতে মিষ্টি গন্ধ থাকলে তবেই তো চোর আসবে।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
