  "hindi_on": 435.496,
  "hindi_off": 442.906,
  "dur": 7.8,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ছোটুর পেট ভরতি ছিল ঠিকই। কিন্তু বুকের ভেতরটা কেমন যেন ভারী লাগছিল। লাড্ডুর চেয়েও বেশি ভারী।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
