  "dur": 2.92,
  "tempo": 1.0,
  "drift": 0.144,
  "spill": 0.0,
  "early": 0.0,
  "text": "না শেরু, ঘুমিয়ে পড়ো! তুমি কিচ্ছু দেখছ না কিন্তু!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
