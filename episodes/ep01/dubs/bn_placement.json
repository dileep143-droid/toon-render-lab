  "tempo": 1.135,
  "drift": 0.0,
  "spill": 0.016,
  "early": 0.0,
  "text": "ঠাকুমা! আমি দেখেছি! একটা... একটা জাদুকরী লাড্ডু চোর এসেছিল!",
  "reused_from": null,
