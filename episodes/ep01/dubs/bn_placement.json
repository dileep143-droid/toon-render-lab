  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.627,
  "early": 0.0,
  "text": "বলও খায়? মা গো, আমার ক্রিকেট বলটা!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
