  "dur": 2.92,
  "tempo": 1.0,
  "drift": 2.158,
  "spill": 0.0,
  "early": 0.0,
  "text": "এটা... এটা প্র্যাকটিস ছিল। জাল একদম ফার্স্টক্লাস কাজ করছে।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
