  "dur": 8.22,
  "tempo": 1.0,
  "drift": 0.38,
  "spill": 0.0,
  "early": 0.0,
  "text": "এই নে চারটে লাড্ডু। কিন্তু খুব সাবধানে রাখিস। এরা আমার সবচেয়ে শান্তশিষ্ট বাচ্চা। কড়াই ছেড়ে কখনো পালায় না।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
