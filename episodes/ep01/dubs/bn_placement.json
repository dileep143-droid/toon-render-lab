[
 {
  "unit": 0,
  "start": 0.431,
  "end": 11.571,
  "hindi_on": 0.431,
  "hindi_off": 11.881,
  "dur": 11.14,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "এই হলো সোনপুর গ্রাম। আর এই আমাদের ঠাকুমার উঠোন। আজ সাঁঝে এখানে পুজো, আর ঠাকুমা বানাচ্ছেন নিজের স্পেশাল বেসনের লাড্ডু!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 1,
  "start": 12.347,
  "end": 21.227,
  "hindi_on": 12.347,
  "hindi_off": 20.457,
  "dur": 9.88,
  "tempo": 1.113,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "এক, দুই, তিন... এগারোটা লাড্ডু! ব্যস, পূজার লেইগা এক্কেবারে ঠিকঠাক।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 2,
  "start": 21.347,
  "end": 26.247,
  "hindi_on": 21.341,
  "hindi_off": 29.251,
  "dur": 4.9,
  "tempo": 1.0,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "আহা... কী দারুণ গন্ধ! ঠাকুমা, আমার খিদে পেয়ে গেছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 3,
  "start": 29.755,
  "end": 33.435,
  "hindi_on": 29.755,
  "hindi_off": 32.485,
  "dur": 4.23,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.147,
  "early": 0.0,
  "text": "এই মাত্র তো তুই চারখান পরোটা খাইলি, ছোটু!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 4,
  "start": 33.555,
  "end": 37.455,
  "hindi_on": 33.408,
  "hindi_off": 36.548,
  "dur": 4.46,
  "tempo": 1.15,
  "drift": 0.147,
  "spill": 0.528,
  "early": 0.0,
  "text": "ওটা তো সকালের খিদে ছিল। এটা হলো এখনকার খিদে।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 5,
  "start": 37.575,
  "end": 45.655,
  "hindi_on": 37.047,
  "hindi_off": 44.487,
  "dur": 9.29,
  "tempo": 1.15,
  "drift": 0.528,
  "spill": 0.343,
  "early": 0.0,
  "text": "এই লাড্ডু ঠাকুরজির লেইগা। পূজা শেষ হইলে সবাই পাইবো। তখন তক কেউ হাত দিবা না কিন্তু। বুঝছোস?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 6,
  "start": 45.775,
  "end": 48.105,
  "hindi_on": 45.432,
  "hindi_off": 47.542,
  "dur": 2.33,
  "tempo": 1.0,
  "drift": 0.343,
  "spill": 0.0,
  "early": 0.0,
  "text": "বুঝে গেছি, ঠাকুমা! হাত এক্কেবারে দেব না।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 7,
  "start": 55.495,
  "end": 61.515,
  "hindi_on": 55.495,
  "hindi_off": 59.305,
  "dur": 6.92,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.216,
  "early": 0.0,
  "text": "আরে, আমার চশমাখান গেল কই? এই তো এহানেই আসিল!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 9,
  "start": 61.635,
  "end": 66.635,
  "hindi_on": 61.419,
  "hindi_off": 67.079,
  "dur": 5.0,
  "tempo": 1.0,
  "drift": 0.216,
  "spill": 0.0,
  "early": 0.0,
  "text": "চমকি, তুইও কইবি না। চল, আমি একটু জিরানি লই।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 10,
  "start": 67.935,
  "end": 76.345,
  "hindi_on": 67.935,
  "hindi_off": 75.965,
  "dur": 8.98,
  "tempo": 1.068,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "দুপুর গড়িয়ে গেল। ঠাকুমা ঘুমিয়ে পড়লেন। শেরুও ঘুমোলো। আর ছোটুর পেট... মোটেই ঘুমোলো না!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 11,
  "start": 76.465,
  "end": 80.565,
  "hindi_on": 76.465,
  "hindi_off": 79.725,
  "dur": 4.7,
  "tempo": 1.148,
  "drift": 0.0,
  "spill": 0.007,
  "early": 0.0,
  "text": "শ্শ্শ, ও পেট মশাই! চুপটি করে থাকো! ঠাকুমা জেগে যাবেন।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 12,
  "start": 80.685,
  "end": 84.915,
  "hindi_on": 80.678,
  "hindi_off": 84.518,
  "dur": 4.79,
  "tempo": 1.131,
  "drift": 0.007,
  "spill": 0.0,
  "early": 0.0,
  "text": "ঠাকুমা বলেছিল, হাত দেওয়া বারণ। তাহলে আমি... মুখ দেব!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
