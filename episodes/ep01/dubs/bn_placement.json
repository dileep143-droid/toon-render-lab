  "tempo": 1.076,
  "drift": 0.0,
  "spill": 0.011,
  "early": 0.0,
  "text": "হ্যাঁ! উড়ে এল জানলা দিয়ে। সুড়ুৎ করে থালায় ঢুকল, আর গপাগপ সব লাড্ডু সাবাড় করে দিল!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
