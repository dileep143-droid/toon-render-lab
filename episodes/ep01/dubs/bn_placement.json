  "dur": 5.96,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.352,
  "early": 0.0,
  "text": "ঠাকুমা, লাড্ডুগুলো আমিই খেয়েছিলাম। আর তার পর মিথ্যে বলেছি। সরি ঠাকুমা।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
