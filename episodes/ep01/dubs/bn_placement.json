  "tempo": 1.0,
  "drift": 0.097,
  "spill": 0.0,
  "early": 0.0,
  "text": "বাচ্চারা! আমিও এসে গেছি! চোর যদি আমার জিলিপির গায়ে হাত দেয়, তবে এই বেলন... এই বেলন দিয়ে বুঝিয়ে দেব!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
