  "hindi_off": 211.537,
  "dur": 4.1,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "জাদুকরী? দেখাই যায় না? মানে... ভূত!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
