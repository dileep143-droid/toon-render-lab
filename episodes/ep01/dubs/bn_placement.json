  "hindi_off": 300.938,
  "dur": 4.01,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "কী বলিস? লাড্ডু চোর? আমাদের গাঁয়ে?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
