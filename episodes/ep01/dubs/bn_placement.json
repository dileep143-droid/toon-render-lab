  "dur": 8.59,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "দেখলে তো? একটা মিথ্যে থেকে এল নীল লেজ, লেজ থেকে এল গান। ছোটুর মিথ্যেটা এবার বটগাছের চেয়েও লম্বা হয়ে উঠল।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 51,
