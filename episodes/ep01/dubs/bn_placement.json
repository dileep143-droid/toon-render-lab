  "tempo": 1.011,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "প্ল্যানটা শোন — চোর লাড্ডু খেতে আসবে, আমি দড়ি টানব, জাল পড়বে, ব্যস চোর ধরা!",
  "reused_from": null,
