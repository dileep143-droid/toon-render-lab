  "tempo": 1.137,
  "drift": 0.0,
  "spill": 0.009,
  "early": 0.0,
  "text": "কী হয়েছে, ঠাকুমা? কোনো গণ্ডগোল নাকি?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
