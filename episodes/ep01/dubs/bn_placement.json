  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ধরে ফেলেছি! রাজু দ্য গ্রেট চোর ধরে ফেলেছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
