  "hindi_on": 85.039,
  "hindi_off": 87.109,
  "dur": 4.25,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.234,
  "early": 0.0,
  "text": "উম্ফ্! ব্যস একটা। শুধু একটাই।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
