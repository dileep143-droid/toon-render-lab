  "hindi_off": 475.275,
  "dur": 13.14,
  "tempo": 1.022,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "হ্যাঁ! আমিই সব কটা লাড্ডু খেয়েছি! কোনো জাদুকরী চোর নেই। নীল লেজও নেই, গানও নেই। খিদে পেয়েছিল, তারপর ভয় পেলাম, আর একটার পর একটা মিথ্যে বলে গেলাম... সরি! সবাইকে সরি!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
