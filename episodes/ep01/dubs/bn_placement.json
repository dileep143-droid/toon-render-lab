  "dur": 5.21,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আসলে... চোরের কোনো লেজ নেই, পকেট আছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
