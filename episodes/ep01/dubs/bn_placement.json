  "tempo": 1.15,
  "drift": 0.002,
  "spill": 0.123,
  "early": 0.0,
  "text": "চিন্তা করবেন না কাকু। রাজু দ্য গ্রেট থাকতে কোনো ভয় নেই।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
