  "tempo": 1.068,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "এই ছোটু! এটা চোরের টোপ, তোর খাওয়ার জন্য নয়!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
