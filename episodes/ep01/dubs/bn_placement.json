  "hindi_on": 429.182,
  "hindi_off": 434.572,
  "dur": 5.87,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "কুছ পরোয়া নেই। কাল ভোরে আবার নতুন প্ল্যান করব। চোর না ধরা পড়া অবধি আমরা সারারাত জেগে থাকব!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
