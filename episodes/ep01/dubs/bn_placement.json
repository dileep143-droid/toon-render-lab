  "tempo": 1.036,
  "drift": 0.013,
  "spill": 0.006,
  "early": 0.0,
  "text": "কাকু, আমার খুব খিদে পেয়েছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
