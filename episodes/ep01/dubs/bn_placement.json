  "end": 269.275,
  "hindi_on": 266.045,
  "hindi_off": 269.715,
  "dur": 3.23,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ফাটাফাটি প্ল্যান! কিন্তু আগে কেউ আমায় এই জাল থেকে বের করো।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 50,
