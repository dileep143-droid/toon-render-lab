  "hindi_on": 164.656,
  "hindi_off": 169.036,
  "dur": 4.0,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আমি? আমি তো... শেরুর পাশে ঘুমোচ্ছিলাম! তাই না রে, শেরু?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
