  "dur": 10.13,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 2.158,
  "early": 0.0,
  "text": "ভয় পেয়ো না! রাজু দ্য গ্রেট চলে এসেছে! চোর যে-ই হোক, এই জাল তাকে পাকড়াও করবেই।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
