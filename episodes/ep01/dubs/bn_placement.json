  "tempo": 1.0,
  "drift": 0.003,
  "spill": 0.0,
  "early": 0.0,
  "text": "ছোটু... এটা তো ঠাকুমার হাতের লাড্ডু।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
