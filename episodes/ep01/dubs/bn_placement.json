  "dur": 4.57,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "হায় হায় রে! আমার লাড্ডু! থালা যে খালি!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
