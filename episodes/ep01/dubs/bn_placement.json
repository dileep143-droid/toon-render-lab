  "dur": 2.04,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "দেখলে? শেরুও মাথা নেড়ে \"হ্যাঁ\" বলছে।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
