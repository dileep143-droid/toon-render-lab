  "dur": 3.06,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "বাবলু ভাইয়া, আমার পেছনে তুমি মোটেই আঁটবে না!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
