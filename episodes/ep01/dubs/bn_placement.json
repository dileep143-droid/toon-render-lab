  "dur": 8.51,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "আর এখান থেকেই শুরু হলো ছোটুর প্রথম মিথ্যে। ও জানত না মিথ্যেও লাড্ডুর মতো — একটা খেলে, আরেকটার খিদে পায়!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
