  "tempo": 1.015,
  "drift": 0.0,
  "spill": 0.013,
  "early": 0.0,
  "text": "একদম কথা দিচ্ছি কাকু। চোর ধরা পড়লেই ফিরিয়ে দিয়ে যাব।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
