  "hindi_off": 147.58,
  "dur": 2.6,
  "tempo": 1.0,
  "drift": 0.011,
  "spill": 0.0,
  "early": 0.0,
  "text": "আচ্ছা? দেখতে ক্যামন আসিল সে?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
