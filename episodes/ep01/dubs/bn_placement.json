  "dur": 4.07,
  "tempo": 1.0,
  "drift": 0.013,
  "spill": 0.0,
  "early": 0.0,
  "text": "তাহলে ও বন্ধ জানলা গলেও বেরোতে পারে! ঠিক বাতাসের মতো! ফুর্র করে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
