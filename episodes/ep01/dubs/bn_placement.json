  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "উফ! থ্যাঙ্ক ইউ রে ছোটু! এ বার আমি শান্তিতে ঘুমোতে পারব!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
