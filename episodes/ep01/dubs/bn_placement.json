  "hindi_off": 307.034,
  "dur": 6.52,
  "tempo": 1.014,
  "drift": 0.0,
  "spill": 0.002,
  "early": 0.0,
  "text": "না না! আমার বাচ্চাদের কেউ ছোঁবে না! জিলিপি রানি, ভয় পাস নে, কাকু আছে তো!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
