  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.54,
  "early": 0.0,
  "text": "আসলে... চোরের লেজটা নীল নয়, বাদামি। আর এটা ডাকছে ঘেউ ঘেউ করে।",
  "reused_from": null,
