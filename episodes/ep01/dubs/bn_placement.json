  "hindi_off": 448.649,
  "dur": 4.54,
  "tempo": 1.133,
  "drift": 0.0,
  "spill": 0.003,
  "early": 0.0,
  "text": "না চমকি, একদম না! ওটা আমার পরের বারের খিদের লাড্ডু!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
