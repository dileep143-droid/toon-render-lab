  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "শোনো! খুট-খাট শব্দ! চোর এসে গেছে!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
