  "dur": 11.09,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "চশমা না আসিলে কী হইসে, নাক তো আসিল! তোর মুখ দিয়া বেসনের সুবাস ছুটতাসিল। আমি শুধু তর নিজের মুখে সত্যি শোনার অপেক্ষায় আছিলাম।",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
