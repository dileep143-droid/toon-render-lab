  "start": 88.129,
  "end": 92.159,
  "hindi_on": 87.625,
  "hindi_off": 91.555,
  "dur": 4.03,
  "tempo": 1.0,
  "drift": 0.504,
  "spill": 0.0,
  "early": 0.0,
  "text": "\"ஒரே ஒண்ணு\"ன்னு சொல்லிக்கிட்டே சோட்டு எண்ணுவதையே விட்டுட்டான்.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 15,
  "start": 92.497,
  "end": 94.747,
  "hindi_on": 92.497,
  "hindi_off": 95.487,
  "dur": 2.25,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "இது அப்புறமா சாப்பிட. அப்புறமா வர்ற பசிக்கு!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 16,
  "start": 95.975,
  "end": 99.655,
  "hindi_on": 95.975,
  "hindi_off": 98.705,
  "dur": 3.68,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "அய்யய்யோ, ஷேரு, நீ தூங்கு! நீ எதுவுமே பாக்கல, சரியா?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 17,
  "start": 102.067,
  "end": 106.497,
  "hindi_on": 102.067,
  "hindi_off": 106.587,
  "dur": 4.43,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ஆத்தி! என் லட்டு! தட்டு காலியா இருக்கே!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 18,
  "start": 107.527,
  "end": 110.317,
  "hindi_on": 107.527,
  "hindi_off": 110.697,
  "dur": 2.79,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "என்னது? பதினொன்னு லட்டுமே காணாம போச்சா?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 19,
  "start": 111.655,
  "end": 113.995,
  "hindi_on": 111.655,
  "hindi_off": 113.605,
  "dur": 2.62,
  "tempo": 1.124,
  "drift": 0.0,
  "spill": 0.009,
  "early": 0.0,
  "text": "என்ன ஆச்சு பாட்டி? ஏதாச்சும் பிரச்சனையா?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 20,
  "start": 114.115,
  "end": 116.875,
  "hindi_on": 114.106,
  "hindi_off": 117.886,
  "dur": 2.76,
  "tempo": 1.0,
  "drift": 0.009,
  "spill": 0.0,
  "early": 0.0,
  "text": "டேய் சோட்டு... உன் வாயில என்னடா இது மஞ்சள் கலர்ல?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 21,
  "start": 118.806,
  "end": 123.756,
  "hindi_on": 118.806,
  "hindi_off": 123.676,
  "dur": 4.95,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "இதா? இது வந்து... என்னோட புது மீசை! வாத்தியார் மீசை மாதிரி!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 22,
  "start": 124.131,
  "end": 128.781,
  "hindi_on": 124.131,
  "hindi_off": 128.371,
  "dur": 4.65,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "கண்ணாடி இல்லாம எனக்கு ஒண்ணுமே கண்ணுக்குத் தெரியலையே!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 23,
  "start": 129.302,
  "end": 132.412,
  "hindi_on": 129.302,
  "hindi_off": 133.532,
  "dur": 3.11,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "பாட்டி! நான் பாத்தேன்! ஒரு... ஒரு மந்திர லட்டு திருடன் வந்தான்!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 24,
  "start": 134.066,
  "end": 136.216,
  "hindi_on": 134.066,
  "hindi_off": 136.496,
  "dur": 2.15,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "மந்திர லட்டு திருடனா?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 25,
  "start": 137.391,
  "end": 142.971,
  "hindi_on": 137.391,
  "hindi_off": 143.001,
  "dur": 5.58,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ஆமா! ஜன்னல் வழியா பறந்து வந்தான். புர்ர்னு தட்டுக்குள்ள நுழைஞ்சு, டக் டக்னு எல்லா லட்டையும் தின்னுட்டான்!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 26,
  "start": 143.93,
  "end": 147.84,
  "hindi_on": 143.93,
  "hindi_off": 147.58,
  "dur": 4.25,
  "tempo": 1.069,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "அப்படியா? அவன் பாக்குறதுக்கு எங்கிட்டு இருந்தான்?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 27,
  "start": 148.027,
  "end": 152.507,
  "hindi_on": 148.027,
  "hindi_off": 152.777,
  "dur": 4.48,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "அவன்... அவன்... கண்ணுக்கே தெரியல! அவன் மந்திர திருடன் இல்ல, அதான்!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 28,
  "start": 153.7,
  "end": 157.26,
  "hindi_on": 153.7,
  "hindi_off": 156.17,
  "dur": 4.1,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.733,
  "early": 0.0,
  "text": "ஆனா சோட்டு, காலையில இருந்து ஜன்னல் மூடிலாம் இருக்கு?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 29,
  "start": 157.38,
  "end": 161.37,
  "hindi_on": 156.647,
  "hindi_off": 160.087,
  "dur": 4.59,
  "tempo": 1.15,
  "drift": 0.733,
  "spill": 0.431,
  "early": 0.0,
  "text": "அதான் மூடில இருக்குற ஜன்னல் வழியாவும் வருவான்! காற்று மாதிரி! புர்ர்னு!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 30,
  "start": 161.49,
  "end": 164.55,
  "hindi_on": 161.059,
  "hindi_off": 164.189,
  "dur": 3.31,
  "tempo": 1.087,
  "drift": 0.431,
  "spill": 0.014,
  "early": 0.0,
  "text": "அப்போ நீ எங்கிட்டு இருந்தே, சோட்டு?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 31,
  "start": 164.67,
  "end": 169.45,
  "hindi_on": 164.656,
  "hindi_off": 169.036,
  "dur": 4.78,
  "tempo": 1.0,
  "drift": 0.014,
  "spill": 0.0,
  "early": 0.0,
  "text": "நானா? நான்... ஷேரு கூட தூங்கிட்டு இருந்தேன்! ஆம்தானே ஷேரு?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 32,
  "start": 169.602,
  "end": 171.592,
  "hindi_on": 169.602,
  "hindi_off": 171.202,
  "dur": 1.99,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "பாத்தீங்களா? ஷேருவும் ஆமான்னு தலையாட்டுது.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 33,
  "start": 172.128,
  "end": 181.308,
  "hindi_on": 172.128,
  "hindi_off": 182.858,
  "dur": 9.18,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "இப்படித்தான் ஆரம்பிச்சது சோட்டுவோட முதல் பொய். பொய் சொல்றதும் லட்டு சாப்பிடுற மாதிரிதான், ஒண்ணு சாப்பிட்டா இன்னொன்னு கேட்கும்னு அவனுக்கு தெரியல!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 34,
  "start": 183.784,
  "end": 192.424,
  "hindi_on": 183.784,
  "hindi_off": 191.574,
  "dur": 8.81,
  "tempo": 1.019,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "நண்பர்களே, சோன்பூர்ல ஒரு மந்திர லட்டு திருடன் சுத்துறான். சாயந்தரம் பூஜை இருக்கு. அவனை நாம பிடிக்கணும். வாங்க, பிளான் போடலாம்!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 35,
  "start": 192.548,
  "end": 197.658,
  "hindi_on": 192.548,
