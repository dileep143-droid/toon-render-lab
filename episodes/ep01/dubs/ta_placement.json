[
 {
  "unit": 0,
  "start": 0.431,
  "end": 11.741,
  "hindi_on": 0.431,
  "hindi_off": 11.881,
  "dur": 11.31,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "இதுதான் சோன்பூர் கிராமம். இது பாட்டியோட முற்றம். இன்னைக்கு சாயந்தரம் இங்கே பூஜை இருக்கு. பாட்டி அவங்களோட ஃபேமஸ் கடலைமாவு லட்டு செய்றாங்க!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 1,
  "start": 12.347,
  "end": 22.607,
  "hindi_on": 12.347,
  "hindi_off": 20.457,
  "dur": 11.78,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.386,
  "early": 0.0,
  "text": "ஒண்ணு, ரெண்டு, மூணு... பதினொன்னு லட்டு! ஆத்தா, பூஜைக்கு போதுமப்பா.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 2,
  "start": 22.727,
  "end": 29.367,
  "hindi_on": 21.341,
  "hindi_off": 29.251,
  "dur": 6.64,
  "tempo": 1.0,
  "drift": 1.386,
  "spill": 0.0,
  "early": 0.0,
  "text": "ஆஹா... என்ன ஒரு மணக்குது! பாட்டி, எனக்கு பசிக்குதுப்பா!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 3,
  "start": 29.755,
  "end": 33.855,
  "hindi_on": 29.755,
  "hindi_off": 32.485,
  "dur": 4.72,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.567,
  "early": 0.0,
  "text": "இப்பதானே நாலு பரோட்டா தின்னே, சோதிக்காதீங்கடா என்னைய!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 4,
  "start": 33.975,
  "end": 36.855,
  "hindi_on": 33.408,
  "hindi_off": 36.548,
  "dur": 2.88,
  "tempo": 1.0,
  "drift": 0.567,
  "spill": 0.0,
  "early": 0.0,
  "text": "அது காலையில எடுத்த பசி. இது இப்போ எடுத்த புதுப் பசி!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 5,
  "start": 37.047,
  "end": 44.547,
  "hindi_on": 37.047,
  "hindi_off": 44.487,
  "dur": 7.5,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "இந்தா பாரு, இது சாமிக்கு. பூஜை முடிஞ்சுதான் கிடைக்கும். அதுவரைக்கும் யாரும் தொட்டாதீங்க, புரியுதா?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 6,
  "start": 45.432,
  "end": 47.612,
  "hindi_on": 45.432,
  "hindi_off": 47.542,
  "dur": 2.18,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "புரிஞ்சிடுச்சு பாட்டி! நான் கையால தொடைவே மாட்டேன்.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 7,
  "start": 55.495,
  "end": 61.305,
  "hindi_on": 55.495,
  "hindi_off": 59.305,
  "dur": 6.01,
  "tempo": 1.035,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "அடடா, என் கண்ணாடி எங்கிட்டு போச்சு? இங்கிட்டுதானே வச்சேன்!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 9,
  "start": 61.425,
  "end": 69.925,
  "hindi_on": 61.419,
  "hindi_off": 67.079,
  "dur": 9.77,
  "tempo": 1.15,
  "drift": 0.006,
  "spill": 2.11,
  "early": 0.0,
  "text": "அச்சோ, சமிக்கி, நீயும் சொல்ல மாட்டையா. சரி, நான் கொஞ்ச நேரம் படுத்துக்குறேன்.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 10,
  "start": 70.045,
  "end": 78.115,
  "hindi_on": 67.935,
  "hindi_off": 75.965,
  "dur": 9.28,
  "tempo": 1.15,
  "drift": 2.11,
  "spill": 1.77,
  "early": 0.0,
  "text": "மத்தியானம் ஆச்சு. பாட்டி தூங்கிட்டாங்க. ஷேரு தூங்கிடுச்சு. ஆனா சோட்டுவோட வயிறு... தூங்கவே இல்லை!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 11,
  "start": 78.235,
  "end": 81.035,
  "hindi_on": 76.465,
  "hindi_off": 79.725,
  "dur": 3.21,
  "tempo": 1.15,
  "drift": 1.77,
  "spill": 0.477,
  "early": 0.0,
  "text": "ஷ்ஷ்ஷ், வயிறே அமைதியா இரு! பாட்டி முழிச்சுப்பாங்க.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 12,
  "start": 81.155,
  "end": 84.915,
  "hindi_on": 80.678,
  "hindi_off": 84.518,
  "dur": 4.05,
  "tempo": 1.076,
  "drift": 0.477,
  "spill": 0.0,
  "early": 0.0,
  "text": "பாட்டி கையால தொடாதேன்னு தானே சொன்னாங்க. அப்போ... வாயால தொடுவேன்!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 13,
