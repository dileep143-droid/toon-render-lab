  "end": 88.009,
  "hindi_on": 85.039,
  "hindi_off": 87.109,
  "dur": 3.41,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.504,
  "early": 0.0,
  "text": "ம்ம்ம்! ஒரே ஒரு லட்டு. ஒரே ஒண்ணுதான்.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
