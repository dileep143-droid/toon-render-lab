  "dur": 7.3,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಈ ಲಾಡು ದೇವರಿಗೈತಿ. ಪೂಜೆ ಆದ್ಮೇಲೆ ಸಿಗ್ತಾವ. ಅಲ್ಲಿವರ್ಗೂ ಯಾರೂ ಮುಟ್ಟಬಾರ್ದು, ತಿಳಿತಾ?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
