  "end": 435.382,
  "hindi_on": 429.182,
  "hindi_off": 434.572,
  "dur": 6.27,
  "tempo": 1.012,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "ಪರವಾಗಿಲ್ಲ. ನಾಳೆ ಬೆಳಗ್ಗೆ ಮತ್ತೆ ಹೊಸ ಪ್ಲಾನ್ ಮಾಡೋಣ. ಕಳ್ಳ ಸಿಗೋವರ್ಗೂ ನಾವ್ ರಾತ್ರಿ ಪೂರ್ತಿ ಎಚ್ಚರ ಇರೋಣ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 78,
