  "dur": 1.83,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ದೆವ್ವ! ದೆವ್ವ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 69,
  "start": 371.886,
  "end": 378.666,
  "hindi_on": 371.886,
  "hindi_off": 377.846,
  "dur": 6.84,
  "tempo": 1.01,
  "drift": 0.0,
  "spill": 0.007,
  "early": 0.0,
  "text": "ಲೇ ಮಕ್ಕಳಾ, ನಾನ್ ನೋಡ್ರಿ. ನನ್ ಕನ್ನಡಕ ಹುಡುಕಾಡ್ತಿದ್ದೆ. ಯಾರಾದ್ರೂ ನೋಡಿದಿರಾ?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 70,
  "start": 378.786,
  "end": 387.216,
  "hindi_on": 378.779,
  "hindi_off": 388.259,
  "dur": 8.43,
  "tempo": 1.0,
  "drift": 0.007,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಮಕ್ಕಳಾ! ನಾನೂ ಬಂದೆ! ಕಳ್ಳ ನನ್ ಜಿಲೇಬಿ ಹತ್ರ ಹೋದ್ರೆ, ಈ ಲಾಟಣಿಗೆ... ಈ ಲಾಟಣಿಗೆ ಅವ್ನಿಗೆ ಸರಿಯಾಗಿ ಬುದ್ಧಿ ಕಲಿಸುತ್ತೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 71,
