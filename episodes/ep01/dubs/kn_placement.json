  "dur": 8.19,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಮಧ್ಯಾಹ್ನ ಆಯ್ತು. ಅಜ್ಜಿ ಮಲಗಿದ್ರು. ಶೇರೂ ಮಲಗಿದ. ಆದ್ರೆ ಚೋಟೂ ಹೊಟ್ಟೆ... ಮಲಗಲೇ ಇಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
