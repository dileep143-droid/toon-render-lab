  "dur": 3.89,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅಜ್ಜಿ ಕೈ ಹಚ್ಚಬೇಡ ಅಂದ್ರು. ಹಾಗಾದ್ರೆ ನಾನ್... ಬಾಯಿ ಹಚ್ಚತೀನಿ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
