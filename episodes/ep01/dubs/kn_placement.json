  "dur": 1.59,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ತಿಳೀತು ಅಜ್ಜಿ! ನಾನಂತೂ ಮುಟ್ಟಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
