  "tempo": 1.04,
  "drift": 0.303,
  "spill": 0.011,
  "early": 0.0,
  "text": "ಅವನು ಮುಚ್ಚಿರೋ ಕಿಟಕಿಯಿಂದಲೂ ಹೋಗ್ತಾನೆ! ಗಾಳಿ ತರ! ಫುರ್ರ್ ಅಂತ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
