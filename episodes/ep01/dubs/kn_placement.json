  "hindi_on": 398.707,
  "hindi_off": 404.167,
  "dur": 4.94,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅಯ್ಯೋ! ನನ್ ಜಿಲೇಬಿಗಳು ಒಂಟಿಯಾಗಿವೆ! ಬಂದೆ ನನ್ ಮಕ್ಕಳೇ, ಬಂದೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
