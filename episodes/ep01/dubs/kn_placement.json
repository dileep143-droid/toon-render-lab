  "tempo": 1.134,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಶ್ಶ್, ಹೊಟ್ಟೆರಾಯ! ಸುಮ್ನೆ ಇರು! ಅಜ್ಜಿ ಎದ್ದುಬಿಡ್ತಾರೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
