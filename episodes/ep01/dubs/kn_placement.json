  "hindi_on": 389.157,
  "hindi_off": 391.557,
  "dur": 2.76,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಮಾವ, ನಮಗೆ ಕಳ್ಳ ಸಿಗ್ಲೇ ಇಲ್ಲ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
