  "end": 427.061,
  "hindi_on": 421.231,
  "hindi_off": 428.671,
  "dur": 5.83,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಪೂಜೆಗೆ ಲಾಡು ಕೂಡ ಇಲ್ಲ. ಅಜ್ಜಿ ಎಷ್ಟು ಬೇಜಾರಾಗಿದ್ದಾರೆ. ಈ ಸಲ ಪೂಜೆ ಅಪೂರ್ಣ ಆಗುತ್ತೆ ಅಂತಿದ್ರು.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
