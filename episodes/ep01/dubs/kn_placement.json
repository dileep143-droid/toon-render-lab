  "dur": 3.38,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅಂದ್ರೆ ಈಗ ನಾನ್ ಬಲೆ ಹಿಡ್ಕೊಂಡು ಮತ್ತೆ ಬೀಳೋದು ಬೇಡ್ವಾ?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
