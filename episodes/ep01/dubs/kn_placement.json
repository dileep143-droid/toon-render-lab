  "hindi_on": 412.512,
  "hindi_off": 420.312,
  "dur": 6.43,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಆಮೇಲೆ ನನ್ ನಡು! ಗ್ರೇಟ್ ರಾಜು ಇವತ್ತು ಮೂರು ಸಾರಿ ಬಿದ್ದಿದ್ದಾನೆ. ಈ ಕಳ್ಳ ತುಂಬಾ ಡೇಂಜರಸ್!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 76,
