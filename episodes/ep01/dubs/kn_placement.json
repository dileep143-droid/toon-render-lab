  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅವನು... ಅವನು... ಕಾಣಿಸ್ತಾನೇ ಇರ್ಲಿಲ್ಲ! ಅವನು ಮಂತ್ರವಾದಿ ಅಲ್ವಾ, ಅದಿಕ್ಕೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
