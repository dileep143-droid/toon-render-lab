  "end": 546.042,
  "hindi_on": 541.676,
  "hindi_off": 545.906,
  "dur": 4.36,
  "tempo": 1.0,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "ನಿಜ ಹೇಳ್ಬೇಕಂದ್ರೆ, ಗುಡಿಯಾ, ನಿನ್ ಪ್ರತಿಯೊಂದು ಪ್ಲಾನ್‌ನಲ್ಲೂ ಒಂದು ತೂತು ಇರುತ್ತೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
