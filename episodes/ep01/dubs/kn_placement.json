  "dur": 2.85,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಗೊತ್ತಿತ್ತಾ? ಆದ್ರೆ ನಿಮ್ಮ ಕನ್ನಡಕ...",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
