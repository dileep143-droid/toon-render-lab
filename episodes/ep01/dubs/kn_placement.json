  "dur": 5.37,
  "tempo": 1.119,
  "drift": 0.0,
  "spill": 0.009,
  "early": 0.0,
  "text": "ಅಬ್ಬಾ! ಥ್ಯಾಂಕ್ ಯು ಚೋಟೂ! ಈಗ ನಾನ್ ನೆಮ್ಮದಿಯಾಗಿ ಮಲಗ್ತೀನಿ!",
  "reused_from": null,
  "spoken_text": null,
