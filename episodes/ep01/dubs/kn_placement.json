  "dur": 2.92,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅಂದ್ರೆ... ನಿಜ ಹೇಳ್ಬೇಕಂದ್ರೆ, ಇವನು ಓವರ್‌ಟೈಮ್ ಕೆಲಸ ಮಾಡ್ತಿರಬೇಕು.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 38,
  "start": 207.747,
  "end": 211.927,
  "hindi_on": 207.747,
  "hindi_off": 211.537,
  "dur": 4.41,
  "tempo": 1.058,
  "drift": 0.0,
  "spill": 0.013,
  "early": 0.0,
  "text": "ಮಾಯಾವಿ? ಕಾಣ್ಸಲ್ವಾ? ಅಂದ್ರೆ... ದೆವ್ವ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 39,
  "start": 212.047,
  "end": 215.267,
  "hindi_on": 212.034,
  "hindi_off": 214.754,
  "dur": 3.22,
  "tempo": 1.0,
  "drift": 0.013,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಬಬ್ಲೂ ಅಣ್ಣಾ, ನನ್ ಹಿಂದೆ ನೀವು ಪೂರ್ತಿ ಬೀರಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 40,
  "start": 215.716,
  "end": 221.636,
  "hindi_on": 215.716,
  "hindi_off": 221.546,
  "dur": 5.92,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಹೆದರ್ಬೇಡಿ! ಗ್ರೇಟ್ ರಾಜು ಬಂದಿದ್ದಾನೆ! ಯಾವ್ದೇ ಕಳ್ಳ ಇರಲಿ, ಈ ಬಲೆ ಅವ್ನನ್ನ ಹಿಡಿಯುತ್ತೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 41,
  "start": 222.488,
  "end": 226.728,
  "hindi_on": 222.488,
  "hindi_off": 228.838,
  "dur": 4.24,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಇದು... ಇದು ಪ್ರಾಕ್ಟೀಸ್ ಅಷ್ಟೇ. ಬಲೆ ಸಕ್ಕತ್ತಾಗಿ ಕೆಲಸ ಮಾಡ್ತಿದೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 42,
  "start": 229.739,
  "end": 234.299,
  "hindi_on": 229.739,
  "hindi_off": 235.239,
  "dur": 4.56,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಚೋಟೂ, ನೀನು ಕಳ್ಳನ್ನ ನೋಡಿದ್ದೀಯಾ. ಹೇಳು, ಅವನ ಇನ್ನೇನು ಗುರುತಿತ್ತು?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 43,
  "start": 235.761,
  "end": 239.361,
  "hindi_on": 235.761,
  "hindi_off": 238.301,
  "dur": 4.13,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.664,
  "early": 0.0,
  "text": "ಗುರುತಾ? ಹುಂ... ಅವನಿಗೆ... ಒಂದು ನೀಲಿ ಬಾಲ ಇದೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 44,
  "start": 239.481,
  "end": 240.221,
  "hindi_on": 238.817,
  "hindi_off": 240.827,
  "dur": 0.74,
  "tempo": 1.0,
  "drift": 0.664,
  "spill": 0.0,
  "early": 0.0,
  "text": "ನೀಲಿ ಬಾಲ. ಆಮೇಲೆ?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 45,
  "start": 241.769,
  "end": 248.609,
  "hindi_on": 241.769,
  "hindi_off": 248.489,
  "dur": 6.84,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಆಮೇಲೆ ಅವನು ಉಂಡೆ ವಸ್ತುಗಳನ್ನೇ ತಿನ್ನೋದು. ಲಾಡು, ಪಾನಿಪುರಿ, ಚೆಂಡು...",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 46,
  "start": 248.953,
  "end": 251.653,
  "hindi_on": 248.953,
  "hindi_off": 250.403,
  "dur": 3.1,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.897,
  "early": 0.0,
  "text": "ಚೆಂಡು ಕೂಡನಾ? ಅಯ್ಯೋ ನನ್ ಕ್ರಿಕೆಟ್ ಬಾಲ್!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 47,
  "start": 251.773,
  "end": 255.913,
  "hindi_on": 250.876,
  "hindi_off": 255.096,
  "dur": 4.58,
  "tempo": 1.104,
  "drift": 0.897,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಆಮೇಲೆ ತಿನ್ನಬೇಕಾದ್ರೆ ಹಾಡು ಹಾಡ್ತಾನೆ — \"ಲಾಡು-ಲಾಡು, ಗಪ್ಪು-ಗಪ್ಪು!\"",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 48,
  "start": 256.043,
  "end": 264.753,
  "hindi_on": 256.043,
  "hindi_off": 265.563,
  "dur": 8.71,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅವನು ಉಂಡೆ ವಸ್ತು ತಿನ್ನೋದಾದ್ರೆ, ನಾವ್ ಅವನನ್ನ ಉಂಡೆ ವಸ್ತುವಿನಿಂದಲೇ ಹಿಡಿಯೋಣ! ಲಲ್ಲನ್ ಕಾಕಾನಿಂದ ಲಾಡು ತಂದು, ಅರಳಿಮರ ಕೆಳಗೆ ಇಟ್ಟು, ಮೇಲೆ ಬಲೆ ಹಾಕೋಣ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 49,
  "start": 266.045,
  "end": 269.895,
  "hindi_on": 266.045,
  "hindi_off": 269.715,
  "dur": 3.85,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಸೂಪರ್ ಪ್ಲಾನ್! ಆದ್ರೆ ಮೊದಲು ಯಾರಾದ್ರೂ ನನ್ನ ಈ ಬಲೆಯಿಂದ ಹೊರಗೆ ತೆಗೀರಿ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 50,
  "start": 273.624,
  "end": 283.954,
  "hindi_on": 273.624,
  "hindi_off": 282.874,
  "dur": 11.83,
  "tempo": 1.145,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ನೋಡಿದ್ರಾ? ಒಂದು ಸುಳ್ಳಿನಿಂದ ನೀಲಿ ಬಾಲ ಬಂತು, ಬಾಲದಿಂದ ಹಾಡು ಬಂತು! ಚೋಟೂವಿನ ಸುಳ್ಳು ಈಗ ಅರಳಿಮರಕ್ಕಿಂತ ಉದ್ದ ಆಗ್ತಿತ್ತು!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 51,
  "start": 284.077,
  "end": 290.837,
  "hindi_on": 284.077,
  "hindi_off": 290.477,
  "dur": 7.64,
  "tempo": 1.128,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅಯ್ಯೋ ನನ್ ಉಂಡೆ ಮಕ್ಕಳೇ! ಬಿಸಿಲಲ್ಲಿ ಕೂರ್ಬೇಡಿ, ಕಪ್ಪಾಗ್ತೀರಾ. ಬನ್ನಿ, ಜೇನಿನ ಪಾಕದಲ್ಲಿ ಮುಳುಗಿ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 52,
  "start": 290.973,
  "end": 296.053,
  "hindi_on": 290.973,
  "hindi_off": 296.043,
  "dur": 5.08,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಲಲ್ಲನ್ ಮಾವ, ನಮಗೆ ನಾಲ್ಕು ಲಾಡು ಬೇಕು. ನಾವು ಮಾಂತ್ರಿಕ ಲಾಡು ಕಳ್ಳನಿಗೆ ಬಲೆ ಬೀಸ್ತಿದ್ದೀವಿ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 53,
  "start": 296.978,
  "end": 301.278,
  "hindi_on": 296.978,
  "hindi_off": 300.938,
  "dur": 4.31,
  "tempo": 1.003,
  "drift": 0.0,
  "spill": 0.004,
  "early": 0.0,
  "text": "ಏನು? ಲಾಡು ಕಳ್ಳನಾ? ನಮ್ಮೂರಿನಲ್ಲಾ?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 54,
  "start": 301.398,
  "end": 309.958,
  "hindi_on": 301.394,
  "hindi_off": 307.034,
  "dur": 9.83,
  "tempo": 1.15,
  "drift": 0.004,
  "spill": 2.136,
  "early": 0.0,
  "text": "ಅಯ್ಯೋ! ನನ್ ಮಕ್ಕಳನ್ನ ಯಾರೂ ಮುಟ್ಟಬಾರ್ದು! ಜಿಲೇಬಿ ರಾಣಿ, ಹೆದರ್ಬೇಡ, ಮಾವ ಇದ್ದೀನಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 55,
  "start": 310.078,
  "end": 313.068,
  "hindi_on": 307.942,
  "hindi_off": 310.692,
  "dur": 3.42,
  "tempo": 1.15,
  "drift": 2.136,
  "spill": 1.997,
  "early": 0.0,
  "text": "ಚಿಂತೆ ಮಾಡ್ಬೇಡಿ ಮಾವ, ಗ್ರೇಟ್ ರಾಜು ಇದ್ದಾನಲ್ಲ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 56,
  "start": 313.188,
  "end": 318.368,
  "hindi_on": 311.191,
  "hindi_off": 315.991,
  "dur": 5.96,
  "tempo": 1.15,
  "drift": 1.997,
  "spill": 1.524,
  "early": 0.0,
  "text": "ಇದು... ಇದೂ ಪ್ಲಾನ್‌ನ ಭಾಗನೇ! ಕೈ ಸಿಹಿಯಾದ್ರೆ, ಕಳ್ಳ ಹತ್ತಿರ ಬರ್ತಾನೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 57,
  "start": 318.488,
  "end": 325.618,
  "hindi_on": 316.964,
  "hindi_off": 325.244,
  "dur": 7.85,
  "tempo": 1.098,
  "drift": 1.524,
  "spill": 0.0,
  "early": 0.0,
  "text": "ತಗೋಳಿ ನಾಲ್ಕು ಲಾಡು. ಆದ್ರೆ ಜೋಪಾನವಾಗಿ ಇಡಿ. ಇವರು ನನ್ ಅತ್ಯಂತ ಸಾಧು ಮಕ್ಕಳು, ಯಾವತ್ತೂ ಬಾಣಲೆಯಿಂದ ಹೊರಗೆ ಹಾರಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 58,
  "start": 325.759,
  "end": 329.079,
  "hindi_on": 325.759,
  "hindi_off": 328.549,
  "dur": 3.32,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಖಂಡಿತ ಮಾವ. ಕಳ್ಳ ಸಿಕ್ಕ ತಕ್ಷಣ ವಾಪಸ್ ತರ್ತೀವಿ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 59,
  "start": 329.516,
  "end": 331.556,
  "hindi_on": 329.516,
  "hindi_off": 331.536,
  "dur": 2.04,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಮಾವ, ನಂಗೆ ಹೊಟ್ಟೆ ಹಸ್ತಿದೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 60,
  "start": 332.013,
  "end": 334.733,
  "hindi_on": 332.013,
  "hindi_off": 334.863,
  "dur": 2.72,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಚೋಟೂ! ಇದು ಕಳ್ಳನಿಗೆ, ನಿನಗಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 61,
  "start": 335.78,
  "end": 342.48,
  "hindi_on": 335.78,
  "hindi_off": 342.15,
  "dur": 7.42,
  "tempo": 1.107,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಪ್ಲಾನ್ ಏನಂದ್ರೆ — ಕಳ್ಳ ಲಾಡು ತಿನ್ನೋಕೆ ಬರ್ತಾನೆ, ನಾನ್ ಹಗ್ಗ ಎಳಿತೀನಿ, ಬಲೆ ಬೀಳುತ್ತೆ, ಕಳ್ಳ ಸಿಕ್ಕಿಬೀಳ್ತಾನೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 62,
  "start": 342.604,
  "end": 347.754,
  "hindi_on": 342.604,
  "hindi_off": 347.354,
  "dur": 5.58,
  "tempo": 1.082,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಗುಡಿಯಾ, ಆದ್ರೆ ಕಳ್ಳ ಕಾಣಿಸ್ಲೇ ಇಲ್ವಲ್ಲ. ಬಲೆ ಬಿದ್ದಾಗ ಒಳಗೆ ಯಾರಿದ್ದಾರೆ ಅಂತ ಹೆಂಗೆ ಗೊತ್ತಾಗುತ್ತೆ?",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 63,
  "start": 347.879,
  "end": 352.069,
  "hindi_on": 347.879,
  "hindi_off": 352.099,
  "dur": 4.19,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅಂ... ಅದು... ಪ್ಲಾನ್‌ನ ಈ ಭಾಗನ ನಾನ್ ನಾಳೆ ಮಾಡ್ತೀನಿ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 64,
  "start": 353.012,
  "end": 356.252,
  "hindi_on": 353.012,
  "hindi_off": 355.972,
  "dur": 3.24,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಕೇಳಿ! ಕುರುಕ್-ಕುರುಕ್! ಕಳ್ಳ ಬಂದ್ಬಿಟ್ಟ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 65,
  "start": 356.436,
  "end": 359.886,
  "hindi_on": 356.436,
  "hindi_off": 359.056,
  "dur": 3.65,
  "tempo": 1.058,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಹಿಡಿದೆ! ಗ್ರೇಟ್ ರಾಜು ಕಳ್ಳನನ್ನ ಹಿಡಿದುಬಿಟ್ಟ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 66,
  "start": 360.006,
  "end": 365.666,
  "hindi_on": 360.006,
  "hindi_off": 365.256,
  "dur": 6.39,
  "tempo": 1.131,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "ನಿಜ ಹೇಳ್ಬೇಕಂದ್ರೆ... ಕಳ್ಳನ ಬಾಲ ನೀಲಿ ಇಲ್ಲ, ಕಂದು ಬಣ್ಣದಲ್ಲಿದೆ. ಆಮೇಲೆ ಇದು ಲೊಳ್ ಅಂತಿದೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 67,
  "start": 365.786,
  "end": 368.766,
  "hindi_on": 365.776,
  "hindi_off": 368.306,
  "dur": 2.98,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಪಿಂಕಿ, ಇವನು ಕಳ್ಳನಲ್ಲ, ಶೇರೂ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 68,
  "start": 369.245,
  "end": 371.075,
  "hindi_on": 369.245,
