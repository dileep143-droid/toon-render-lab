  "dur": 3.78,
  "tempo": 1.0,
  "drift": 0.217,
  "spill": 0.0,
  "early": 0.0,
  "text": "ನಿಜ ಹೇಳ್ಬೇಕಂದ್ರೆ... ಕಳ್ಳನಿಗೆ ಬಾಲ ಇಲ್ಲ, ಜೇಬು ಇದೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
