  "dur": 3.22,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಈಗಷ್ಟ ನಾಲ್ಕು ಪರಾಠಾ ತಿಂದಿಯಲ್ಲಾ, ಚೋಟೂ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
