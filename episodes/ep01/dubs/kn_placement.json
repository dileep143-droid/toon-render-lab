  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ನಂಗೆ ಗೊತ್ತಿತ್ತಲ್ಲೋ ಚೋಟೂ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
