  "end": 412.402,
  "hindi_on": 405.062,
  "hindi_off": 412.012,
  "dur": 8.0,
  "tempo": 1.091,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "ಈಗ ನಾನ್ ರಾತ್ರಿ ಮಲಗೋಕೂ ಆಗಲ್ಲ. ನೀಲಿ ಬಾಲದ ದೆವ್ವ ಹಾಡು ಹಾಡುತ್ತೆ, \"ಲಾಡು-ಲಾಡು, ಗಪ್ಪು-ಗಪ್ಪು\"...",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
