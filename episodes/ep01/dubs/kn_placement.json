  "hindi_on": 527.375,
  "hindi_off": 534.465,
  "dur": 4.02,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಇಲ್ಲ ರಾಜು, ಈಗ ಬರಿ ಹಿಟ್ಟಿಗೆ ಕೈ ಹಚ್ಚಬೇಕು ಅಷ್ಟೇ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 96,
  "start": 535.402,
  "end": 541.562,
  "hindi_on": 535.402,
  "hindi_off": 541.172,
  "dur": 6.73,
  "tempo": 1.094,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "ಬನ್ನಿ ಪ್ಲಾನ್ ಮಾಡೋಣ! ಲಾಡು ಮಾಡೋ ಪ್ಲಾನ್! ಈ ಸಲ ಪ್ಲಾನ್‌ನಲ್ಲಿ ಯಾವ ಲೋಪನೂ ಇರಲ್ಲ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
