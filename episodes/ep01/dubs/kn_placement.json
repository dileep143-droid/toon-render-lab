  "end": 443.302,
  "hindi_on": 435.496,
  "hindi_off": 442.906,
  "dur": 7.8,
  "tempo": 1.0,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಚೋಟೂ ಹೊಟ್ಟೆ ಅಂತೂ ತುಂಬಿತ್ತು. ಆದ್ರೆ ಈಗ ಅವನ ಮನಸ್ಸಿಗೆ ತುಂಬಾ ಬೇಜಾರಾಗ್ತಿತ್ತು. ಲಾಡುಗಿಂತಲೂ ಭಾರವಾಗಿ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
