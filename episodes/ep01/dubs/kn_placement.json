  "tempo": 1.0,
  "drift": 0.016,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಚಮ್ಕಿ, ನೀನೂ ಹೇಳಲ್ಲ ಬಿಡು. ನಡೆ, ನಾನ್ ಸ್ವಲ್ಪ ಒಡ್ಕೋತೀನಿ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
