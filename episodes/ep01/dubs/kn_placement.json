  "dur": 2.96,
  "tempo": 1.0,
  "drift": 0.232,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಇಲ್ಲ ಬಬ್ಲೂ ಅಣ್ಣಾ. ದೆವ್ವ ಇಲ್ಲ. ಬರಿ ನಾನು.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
