  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ನಿಜ ಹೇಳ್ಬೇಕಂದ್ರೆ, ನಾನ್ ಪುಸ್ತಕದಲ್ಲಿ ಓದಿದ್ದೀನಿ, ಲಾಡು ಕಳ್ಳಂದಿರು ಮಂಗಳವಾರ ಮಾತ್ರ ಬರ್ತಾರೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
  "unit": 36,
  "start": 198.376,
  "end": 200.476,
  "hindi_on": 198.376,
  "hindi_off": 200.306,
  "dur": 2.1,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಪಿಂಕಿ, ಇವತ್ತು ಬುಧವಾರ ಕಣೆ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
