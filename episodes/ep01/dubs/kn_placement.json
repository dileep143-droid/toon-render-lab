  "dur": 2.98,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಚೋಟೂ... ಇದು ಅಜ್ಜಿ ಮಾಡಿದ ಲಾಡ ಅಲ್ವಾ.",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
