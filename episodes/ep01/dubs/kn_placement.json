  "dur": 3.69,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.217,
  "early": 0.0,
  "text": "ಹಾಗಾದ್ರೆ ನೀಲಿ ಬಾಲದ ಕಳ್ಳ...",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
