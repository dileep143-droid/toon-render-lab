  "dur": 2.9,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಇನ್ನೊಮ್ಮೆ ಯಾವತ್ತೂ ಸುಳ್ಳು ಹೇಳಲ್ಲ ಅಜ್ಜಿ. ಸುಳ್ಳು ಹೇಳಿ ಸಾಕಾಯ್ತು!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
