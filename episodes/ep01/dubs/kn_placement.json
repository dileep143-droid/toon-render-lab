  "tempo": 1.089,
  "drift": 0.0,
  "spill": 0.016,
  "early": 0.0,
  "text": "ಯಪ್ಪಾ, ನನ್ನ ಕನ್ನಡಕ ಎಲ್ಲೇ ಹೋತು? ಈಗ ಇಲ್ಲೇ ಇತ್ತಲ್ಲಾ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
