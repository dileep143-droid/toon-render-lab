  "dur": 12.34,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಹೌದು! ನಾನೇ ಎಲ್ಲ ಲಾಡು ತಿಂದಿದ್ದು! ಯಾವ ಮಾಂತ್ರಿಕ ಕಳ್ಳನೂ ಇಲ್ಲ. ನೀಲಿ ಬಾಲನೂ ಇಲ್ಲ, ಹಾಡೂ ಇಲ್ಲ. ನಂಗೆ ಹಸಿವಾಗಿತ್ತು, ಆಮೇಲೆ ಹೆದರಿಕೆಯಾಯ್ತು, ಸುಳ್ಳು ಹೇಳ್ತಾ ಹೋದೆ... ಸೋರಿ! ಎಲ್ಲರಿಗೂ ಸೋರಿ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
