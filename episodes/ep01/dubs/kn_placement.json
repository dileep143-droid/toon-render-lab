  "dur": 1.99,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಅದು ಬೆಳಗಿನ ಹಸಿವು. ಇದು ಈಗಿನ ಹಸಿವು!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
