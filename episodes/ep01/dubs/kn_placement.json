  "hindi_on": 445.479,
  "hindi_off": 448.649,
  "dur": 2.61,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ಬೇಡ ಚಮ್ಕಿ, ಬೇಡ! ಅದು ಆಮೇಲೆ ಬರೋ ಹಸಿವಿಗೆ!",
  "reused_from": null,
  "spoken_text": null,
  "cut": false
 },
 {
