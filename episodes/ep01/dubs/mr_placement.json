[
 {
  "unit": 0,
  "start": 0.431,
  "end": 11.161,
  "hindi_on": 0.431,
  "hindi_off": 11.881,
  "dur": 10.73,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे आहे आपलं सोनपूर गाव. अन् हे आजीचं वाडं. आज संध्याकाळी इथं पूजा आहे, अन् आजी बनवतेय तिचे मस्त बेसन लाडू!",
  "cut": false
 },
 {
  "unit": 1,
  "start": 12.347,
  "end": 20.217,
  "hindi_on": 12.347,
  "hindi_off": 20.457,
  "dur": 7.87,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "एक, दोन, तीन... अकरा लाडू! बस, पूजेसाठी बास झाले बाप्पा.",
  "cut": false
 },
 {
  "unit": 2,
  "start": 21.341,
  "end": 29.631,
  "hindi_on": 21.341,
  "hindi_off": 29.251,
  "dur": 8.78,
  "tempo": 1.059,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आहा... कसला भारी वास! आजी, मला खूप भूक लागलीये!",
  "cut": false
 },
 {
  "unit": 3,
  "start": 29.755,
  "end": 34.085,
  "hindi_on": 29.755,
  "hindi_off": 32.485,
  "dur": 4.97,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.797,
  "early": 0.0,
  "text": "आत्ताच तर तू चार पराठे खाल्ले जो, छोटू!",
  "cut": false
 },
 {
  "unit": 4,
  "start": 34.205,
  "end": 37.435,
  "hindi_on": 33.408,
  "hindi_off": 36.548,
  "dur": 3.72,
  "tempo": 1.15,
  "drift": 0.797,
  "spill": 0.508,
  "early": 0.0,
  "text": "ती तर सकाळची भूक होती. ही आत्ताची भूक आहे.",
  "cut": false
 },
 {
  "unit": 5,
  "start": 37.555,
  "end": 45.035,
  "hindi_on": 37.047,
  "hindi_off": 44.487,
  "dur": 7.48,
  "tempo": 1.0,
  "drift": 0.508,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे लाडू देवासाठी हायेत. पूजेनंतरच भेटतील तुले. तोवर हात नकाय लावू. समजला का?",
  "cut": false
 },
 {
  "unit": 6,
  "start": 45.432,
  "end": 48.002,
  "hindi_on": 45.432,
  "hindi_off": 47.542,
  "dur": 2.57,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "समजलं आजी! अजिबात हात नाही लावणार.",
  "cut": false
 },
 {
  "unit": 7,
  "start": 55.495,
  "end": 61.295,
  "hindi_on": 55.495,
  "hindi_off": 59.305,
  "dur": 5.98,
  "tempo": 1.03,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "अरे देवा, माहा चष्मा कुठं गेला? आत्ताच इथं होता!",
  "cut": false
 },
 {
  "unit": 9,
  "start": 61.419,
  "end": 66.849,
  "hindi_on": 61.419,
  "hindi_off": 67.079,
  "dur": 5.43,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "चमकी, तू बी नाई सांगत. चाल, मी जरा टेकून राहते.",
  "cut": false
 },
 {
  "unit": 10,
  "start": 67.935,
  "end": 76.355,
  "hindi_on": 67.935,
  "hindi_off": 75.965,
  "dur": 9.23,
  "tempo": 1.098,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "दुपार झाली. आजी झोपली. शेरू झोपला. अन् छोटूचं पोट... अजिबात नाही झोपलं!",
  "cut": false
 },
 {
  "unit": 11,
  "start": 76.475,
  "end": 80.645,
  "hindi_on": 76.465,
  "hindi_off": 79.725,
  "dur": 4.78,
  "tempo": 1.15,
  "drift": 0.01,
  "spill": 0.087,
  "early": 0.0,
  "text": "श्श्श, पोटोबा! गप्प बसा! आजी जागेल ना.",
  "cut": false
 },
 {
  "unit": 12,
  "start": 80.765,
  "end": 85.075,
  "hindi_on": 80.678,
  "hindi_off": 84.518,
  "dur": 4.97,
  "tempo": 1.15,
  "drift": 0.087,
  "spill": 0.156,
  "early": 0.0,
  "text": "आजी म्हणाली होती, हात लावू नकोस. मग मी... तोंड लावेन!",
  "cut": false
 },
 {
  "unit": 13,
  "start": 85.195,
  "end": 88.865,
  "hindi_on": 85.039,
  "hindi_off": 87.109,
  "dur": 4.22,
  "tempo": 1.15,
  "drift": 0.156,
  "spill": 1.36,
  "early": 0.0,
  "text": "यम्मी! फक्त एकच. एकच लाडू.",
  "cut": false
 },
 {
  "unit": 14,
  "start": 88.985,
  "end": 92.725,
  "hindi_on": 87.625,
  "hindi_off": 91.555,
  "dur": 4.3,
  "tempo": 1.15,
  "drift": 1.36,
  "spill": 0.348,
  "early": 0.0,
  "text": "\"फक्त एक\" म्हणता म्हणता छोटू मोजायचंच विसरून गेला.",
  "cut": false
 },
 {
  "unit": 15,
  "start": 92.845,
  "end": 95.605,
  "hindi_on": 92.497,
  "hindi_off": 95.487,
  "dur": 2.76,
  "tempo": 1.0,
  "drift": 0.348,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे नंतरसाठी. नंतरच्या भुकेसाठी!",
  "cut": false
 },
 {
  "unit": 16,
  "start": 95.975,
  "end": 98.445,
  "hindi_on": 95.975,
  "hindi_off": 98.705,
  "dur": 2.47,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "नाही शेरू, झोप पाहू! तू काहीच नाही बघतोयस!",
  "cut": false
 },
 {
  "unit": 17,
  "start": 102.067,
  "end": 106.457,
  "hindi_on": 102.067,
  "hindi_off": 106.587,
  "dur": 4.39,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "अरे बापरे! माहे लाडू! ताट तर रिकामं हाय!",
  "cut": false
 },
 {
  "unit": 18,
  "start": 107.527,
  "end": 110.827,
  "hindi_on": 107.527,
  "hindi_off": 110.697,
  "dur": 3.3,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "काय? अकराच्या अकरा लाडू गायब?",
  "cut": false
 },
 {
  "unit": 19,
  "start": 111.655,
  "end": 113.565,
  "hindi_on": 111.655,
  "hindi_off": 113.605,
  "dur": 1.91,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "काय झालं आजी? काही अडचण आहे का?",
  "cut": false
 },
 {
  "unit": 20,
  "start": 114.106,
  "end": 118.326,
  "hindi_on": 114.106,
  "hindi_off": 117.886,
  "dur": 4.22,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "छोटू... तुझ्या तोंडाला हे पिवळं पिवळं काय आहे?",
  "cut": false
 },
 {
  "unit": 21,
  "start": 118.806,
  "end": 122.726,
  "hindi_on": 118.806,
  "hindi_off": 123.676,
  "dur": 3.92,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे? हे तर... माझी नवीन मिशी आहे! गुरुजींसारखी.",
  "cut": false
 },
 {
  "unit": 22,
  "start": 124.131,
  "end": 128.351,
  "hindi_on": 124.131,
  "hindi_off": 128.371,
  "dur": 4.22,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "मले चष्म्याशिवाय काही दिसत बी नाई जो.",
  "cut": false
 },
 {
  "unit": 23,
  "start": 129.302,
  "end": 133.362,
  "hindi_on": 129.302,
  "hindi_off": 133.532,
  "dur": 4.06,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आजी! मी पाहिलं! एक... एक जादुई लाडू चोर आला होता!",
  "cut": false
 },
 {
  "unit": 24,
  "start": 134.066,
  "end": 135.846,
  "hindi_on": 134.066,
  "hindi_off": 136.496,
  "dur": 1.78,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "जादुई लाडू चोर?",
  "cut": false
 },
 {
  "unit": 25,
  "start": 137.391,
  "end": 143.811,
  "hindi_on": 137.391,
  "hindi_off": 143.001,
  "dur": 6.45,
  "tempo": 1.005,
  "drift": 0.0,
  "spill": 0.001,
  "early": 0.0,
  "text": "हो! तो उडून आला, खिडकीतून. फुर्र करून ताटात शिरला, अन् गपागप सगळे लाडू खाऊन गेला!",
  "cut": false
 },
 {
  "unit": 26,
  "start": 143.931,
  "end": 147.021,
  "hindi_on": 143.93,
  "hindi_off": 147.58,
  "dur": 3.09,
  "tempo": 1.0,
  "drift": 0.001,
  "spill": 0.0,
  "early": 0.0,
  "text": "अस्सं? मंग कसा दिसत होता तो?",
  "cut": false
 },
 {
  "unit": 27,
  "start": 148.027,
  "end": 152.737,
  "hindi_on": 148.027,
  "hindi_off": 152.777,
  "dur": 4.71,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "तो... तो... दिसतच नव्हता! तो जादुई आहे ना, म्हणून!",
  "cut": false
 },
 {
  "unit": 28,
  "start": 153.7,
  "end": 156.52,
  "hindi_on": 153.7,
  "hindi_off": 156.17,
  "dur": 2.95,
  "tempo": 1.044,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "पण छोटू, खिडकी तर सकाळपासून बंद आहे.",
  "cut": false
 },
 {
  "unit": 29,
  "start": 156.647,
  "end": 160.547,
  "hindi_on": 156.647,
  "hindi_off": 160.087,
  "dur": 3.9,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "मग तो बंद खिडकीतून पण पार होतो! वाऱ्यासारखा! फुर्र!",
  "cut": false
 },
 {
  "unit": 30,
  "start": 161.059,
  "end": 163.699,
  "hindi_on": 161.059,
  "hindi_off": 164.189,
  "dur": 2.64,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "मंग तू तव्हा कुठं होता बे, छोटू?",
  "cut": false
 },
 {
  "unit": 31,
  "start": 164.656,
  "end": 168.656,
  "hindi_on": 164.656,
  "hindi_off": 169.036,
  "dur": 4.0,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "मी? मी तर... शेरूसोबत झोपलो होतो! हो ना शेरू?",
  "cut": false
 },
 {
  "unit": 32,
  "start": 169.602,
  "end": 171.822,
  "hindi_on": 169.602,
  "hindi_off": 171.202,
  "dur": 2.22,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "बघितलंस? शेरू पण \"हो\" म्हणतोय.",
  "cut": false
 },
 {
  "unit": 33,
  "start": 172.128,
  "end": 183.048,
  "hindi_on": 172.128,
  "hindi_off": 182.858,
  "dur": 10.92,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "अन् इथूनच सुरू झालं छोटूचं पहिलं खोटं बोलणं. बिचाऱ्याला ठाऊक नव्हतं की खोटं पण लाडूसारखं असतं — एक खाल्लं, की दुसरं मागतं!",
  "cut": false
 },
 {
  "unit": 34,
  "start": 183.784,
  "end": 192.444,
  "hindi_on": 183.784,
  "hindi_off": 191.574,
  "dur": 9.01,
  "tempo": 1.042,
  "drift": 0.0,
  "spill": 0.016,
  "early": 0.0,
  "text": "मित्रांनो, सोनपूरमध्ये एक जादुई लाडू चोर फिरतोय. संध्याकाळी पूजा आहे. आपल्याला त्याला पकडावंच लागेल. चला, प्लॅन करूया!",
  "cut": false
 },
 {
  "unit": 35,
  "start": 192.564,
  "end": 197.174,
  "hindi_on": 192.548,
  "hindi_off": 197.428,
  "dur": 4.61,
  "tempo": 1.0,
  "drift": 0.016,
  "spill": 0.0,
  "early": 0.0,
  "text": "खरं तर, मी पुस्तकात वाचलंय की लाडू चोर फक्त मंगळवारीच येतात.",
  "cut": false
 },
 {
  "unit": 36,
  "start": 198.376,
  "end": 200.106,
  "hindi_on": 198.376,
  "hindi_off": 200.306,
  "dur": 1.73,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "पिंकी, आज तर बुधवार आहे.",
  "cut": false
 },
 {
  "unit": 37,
  "start": 200.824,
  "end": 204.344,
  "hindi_on": 200.824,
  "hindi_off": 206.844,
  "dur": 3.52,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "तर... खरं तर, हा नक्कीच ओव्हरटाईम करत असेल.",
  "cut": false
 },
 {
  "unit": 38,
  "start": 207.747,
  "end": 211.927,
  "hindi_on": 207.747,
  "hindi_off": 211.537,
  "dur": 4.49,
  "tempo": 1.078,
  "drift": 0.0,
  "spill": 0.013,
  "early": 0.0,
  "text": "जादुई? दिसत नाही? म्हणजे... भूत!",
  "cut": false
 },
 {
  "unit": 39,
  "start": 212.047,
  "end": 214.947,
  "hindi_on": 212.034,
  "hindi_off": 214.754,
  "dur": 2.9,
  "tempo": 1.0,
  "drift": 0.013,
  "spill": 0.0,
  "early": 0.0,
  "text": "बबलू दादा, माझ्या मागे तुम्ही लपूच शकत नाही!",
  "cut": false
 },
 {
  "unit": 40,
  "start": 215.716,
  "end": 222.356,
  "hindi_on": 215.716,
  "hindi_off": 221.546,
  "dur": 6.64,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "घाबरू नका! राजू द ग्रेट आलाय! कोणताही चोर असू दे, हे जाळं त्याला पकडेलच.",
  "cut": false
 },
 {
  "unit": 41,
  "start": 222.488,
  "end": 226.508,
  "hindi_on": 222.488,
  "hindi_off": 228.838,
  "dur": 4.02,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे... ही तर प्रॅक्टिस होती. जाळं एकदम मस्त काम करतंय.",
  "cut": false
 },
 {
  "unit": 42,
  "start": 229.739,
  "end": 234.019,
  "hindi_on": 229.739,
  "hindi_off": 235.239,
  "dur": 4.28,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "छोटू, तू चोर बघितलास ना. सांग ना, त्याची आणखी काय खूण आहे?",
  "cut": false
 },
 {
  "unit": 43,
  "start": 235.761,
  "end": 239.741,
  "hindi_on": 235.761,
  "hindi_off": 238.301,
  "dur": 4.58,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.044,
  "early": 0.0,
  "text": "खूण? अं... त्याला... एक निळी शेपूट आहे!",
  "cut": false
 },
 {
  "unit": 44,
  "start": 239.861,
  "end": 241.641,
  "hindi_on": 238.817,
  "hindi_off": 240.827,
  "dur": 1.78,
  "tempo": 1.0,
  "drift": 1.044,
  "spill": 0.0,
  "early": 0.0,
  "text": "निळी शेपूट. आणि?",
  "cut": false
 },
 {
  "unit": 45,
  "start": 241.769,
  "end": 246.979,
  "hindi_on": 241.769,
  "hindi_off": 248.489,
  "dur": 5.21,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आणि तो फक्त गोल गोल गोष्टीच खातो. लाडू, शेवपूरी, चेंडू...",
  "cut": false
 },
 {
  "unit": 46,
  "start": 248.953,
  "end": 251.153,
  "hindi_on": 248.953,
  "hindi_off": 250.403,
  "dur": 2.55,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.397,
  "early": 0.0,
  "text": "चेंडू पण? माझी क्रिकेटची बॉल!",
  "cut": false
 },
 {
  "unit": 47,
  "start": 251.273,
  "end": 255.183,
  "hindi_on": 250.876,
  "hindi_off": 255.096,
  "dur": 3.91,
  "tempo": 1.0,
  "drift": 0.397,
  "spill": 0.0,
  "early": 0.0,
  "text": "आणि खाताना तो गाणंसुद्धा गातो — \"लाडू-लाडू, गप्पू-गप्पू!\"",
  "cut": false
 },
 {
  "unit": 48,
  "start": 256.043,
  "end": 263.683,
  "hindi_on": 256.043,
  "hindi_off": 265.563,
  "dur": 7.64,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "जर तो गोल गोष्टी खातो, तर आपण त्याला गोल गोष्टीनेच पकडू! लल्लन काकांकडून लाडू आणू, पिंपळाखाली ठेवू, आणि वर जाळं लावू!",
  "cut": false
 },
 {
  "unit": 49,
  "start": 266.045,
  "end": 270.155,
  "hindi_on": 266.045,
  "hindi_off": 269.715,
  "dur": 4.11,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "मस्त प्लॅन! पण आधी कोणीतरी मला या जाळ्यातून बाहेर काढा.",
  "cut": false
 },
 {
  "unit": 50,
  "start": 273.624,
  "end": 283.234,
  "hindi_on": 273.624,
  "hindi_off": 282.874,
  "dur": 9.61,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "बघितलंत? एका खोट्यामुळे निळी शेपूट बनली, शेपटावरून गाणं बनलं. छोटूचं खोटं आता पिंपळाच्या झाडापेक्षाही लांब होत चाललं होतं.",
  "cut": false
 },
 {
  "unit": 51,
  "start": 284.077,
  "end": 290.867,
  "hindi_on": 284.077,
  "hindi_off": 290.477,
  "dur": 7.25,
  "tempo": 1.07,
  "drift": 0.0,
  "spill": 0.014,
  "early": 0.0,
  "text": "अरे माझ्या गोल गोल बाळांनो! उन्हात बसू नका, काळे व्हाल. चला, पाकात डुबकी मारा.",
  "cut": false
 },
 {
  "unit": 52,
  "start": 290.987,
  "end": 296.097,
  "hindi_on": 290.973,
  "hindi_off": 296.043,
  "dur": 5.11,
  "tempo": 1.0,
  "drift": 0.014,
  "spill": 0.0,
  "early": 0.0,
  "text": "लल्लन काका, आम्हाला चार लाडू हवेत. आम्ही जादुई लाडू चोरासाठी जाळं रचतोय.",
  "cut": false
 },
 {
  "unit": 53,
  "start": 296.978,
  "end": 300.378,
  "hindi_on": 296.978,
  "hindi_off": 300.938,
  "dur": 3.4,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "काय? लाडू चोर? आपल्या गावात?",
  "cut": false
 },
 {
  "unit": 54,
  "start": 301.394,
  "end": 307.954,
  "hindi_on": 301.394,
  "hindi_off": 307.034,
  "dur": 7.54,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.132,
  "early": 0.0,
  "text": "नाही! माझ्या पोरांना कोणी हात नाही लावणार! जिलेबी राणी, घाबरू नको, काका आहे ना!",
  "cut": false
 },
 {
  "unit": 55,
  "start": 308.074,
  "end": 311.464,
  "hindi_on": 307.942,
  "hindi_off": 310.692,
  "dur": 3.89,
  "tempo": 1.15,
  "drift": 0.132,
  "spill": 0.393,
  "early": 0.0,
  "text": "काळजी नका करू काका. राजू द ग्रेट आहे ना.",
  "cut": false
 },
 {
  "unit": 56,
  "start": 311.584,
  "end": 316.394,
  "hindi_on": 311.191,
  "hindi_off": 315.991,
  "dur": 4.81,
  "tempo": 1.0,
  "drift": 0.393,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे... हेसुद्धा प्लॅनचाच भाग होतं. हात गोड असले की चोर जवळ येईल.",
  "cut": false
 },
 {
  "unit": 57,
  "start": 316.964,
  "end": 324.114,
  "hindi_on": 316.964,
  "hindi_off": 325.244,
  "dur": 7.15,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे घ्या चार लाडू. पण सांभाळून ठेवा. हे माझे एकदम गुणी बाळ आहेत. कढईतून कधी बाहेर उडी नाही मारत.",
  "cut": false
 },
 {
  "unit": 58,
  "start": 325.759,
  "end": 328.959,
  "hindi_on": 325.759,
  "hindi_off": 328.549,
  "dur": 3.2,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "नक्की काका. चोर पकडला की लगेच परत आणतो.",
  "cut": false
 },
 {
  "unit": 59,
  "start": 329.516,
  "end": 331.526,
  "hindi_on": 329.516,
  "hindi_off": 331.536,
  "dur": 2.01,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "काका, मला भूक लागलीये!",
  "cut": false
 },
 {
  "unit": 60,
  "start": 332.013,
  "end": 335.423,
  "hindi_on": 332.013,
  "hindi_off": 334.863,
  "dur": 3.41,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "छोटू! हे चोरासाठी आहेत, तुझ्यासाठी नाहीत!",
  "cut": false
 },
 {
  "unit": 61,
  "start": 335.78,
  "end": 341.97,
  "hindi_on": 335.78,
  "hindi_off": 342.15,
  "dur": 6.19,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "प्लॅन असा आहे — चोर लाडू खायला येईल, मी दोरी ओढीन, जाळं पडेल, आणि चोर पकडला जाईल!",
  "cut": false
 },
 {
  "unit": 62,
  "start": 342.604,
  "end": 348.674,
  "hindi_on": 342.604,
  "hindi_off": 347.354,
  "dur": 6.98,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.915,
  "early": 0.0,
  "text": "गुडिया, पण चोर तर दिसतच नाही. जाळं पडल्यावर आत कोणी आहे हे कसं कळणार?",
  "cut": false
 },
 {
  "unit": 63,
  "start": 348.794,
  "end": 350.604,
  "hindi_on": 347.879,
  "hindi_off": 352.099,
  "dur": 1.81,
  "tempo": 1.0,
  "drift": 0.915,
  "spill": 0.0,
  "early": 0.0,
  "text": "अं... ते... प्लॅनचा हा भाग मी उद्या ठरवेन.",
  "cut": false
 },
 {
  "unit": 64,
  "start": 353.012,
  "end": 356.132,
  "hindi_on": 353.012,
  "hindi_off": 355.972,
  "dur": 3.12,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ऐका! कुरुम-कुरुम! चोर आला!",
  "cut": false
 },
 {
  "unit": 65,
  "start": 356.436,
  "end": 359.896,
  "hindi_on": 356.436,
  "hindi_off": 359.056,
  "dur": 3.82,
  "tempo": 1.107,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "पकडला! राजू द ग्रेटने चोराला पकडला!",
  "cut": false
 },
 {
  "unit": 66,
  "start": 360.016,
  "end": 364.586,
  "hindi_on": 360.006,
  "hindi_off": 365.256,
  "dur": 4.57,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "खरं तर... चोराची शेपूट निळी नाही, तपकिरी आहे. आणि हा भुंकतोय.",
  "cut": false
 },
 {
  "unit": 67,
  "start": 365.776,
  "end": 368.216,
  "hindi_on": 365.776,
  "hindi_off": 368.306,
  "dur": 2.44,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "पिंकी, हा चोर नाही, शेरू आहे!",
  "cut": false
 },
 {
  "unit": 68,
  "start": 369.245,
  "end": 371.515,
  "hindi_on": 369.245,
  "hindi_off": 371.405,
  "dur": 2.27,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "भूत! भूऽऽत!",
  "cut": false
 },
 {
  "unit": 69,
  "start": 371.886,
  "end": 377.636,
  "hindi_on": 371.886,
  "hindi_off": 377.846,
  "dur": 5.75,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "अरे लेकरांनो, मी हाय रे. माहा चष्मा शोधून रायली. पाहिला का कोणी?",
  "cut": false
 },
 {
  "unit": 70,
  "start": 378.779,
  "end": 387.869,
  "hindi_on": 378.779,
  "hindi_off": 388.259,
  "dur": 9.09,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "मुलांनो! मी पण आलो! जर चोर माझ्या जिलेब्यांपर्यंत पोहोचला, तर हा लाटना... हा लाटना त्याला प्रेमाने समजवेल!",
  "cut": false
 },
 {
  "unit": 71,
  "start": 389.157,
  "end": 392.097,
  "hindi_on": 389.157,
  "hindi_off": 391.557,
  "dur": 2.94,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "काका, आम्हाला चोर सापडलाच नाही.",
  "cut": false
 },
 {
  "unit": 72,
  "start": 392.501,
  "end": 397.991,
  "hindi_on": 392.501,
  "hindi_off": 398.211,
  "dur": 5.49,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "तो... तो ना, आता लल्लन काकांच्या दुकानाकडे गेला असेल! मी त्याची निळी शेपूट तिकडे जाताना पाहिली!",
  "cut": false
 },
 {
  "unit": 73,
  "start": 398.707,
  "end": 404.127,
  "hindi_on": 398.707,
  "hindi_off": 404.167,
  "dur": 5.42,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आई गं! माझ्या जिलेब्या एकट्या आहेत! आलो रे माझ्या बाळांनो!",
  "cut": false
 },
 {
  "unit": 74,
  "start": 405.062,
  "end": 412.402,
  "hindi_on": 405.062,
  "hindi_off": 412.012,
  "dur": 8.07,
  "tempo": 1.101,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "आता मी रात्री झोपू पण शकणार नाही. निळ्या शेपटाचं भूत गाणं गाईल, \"लाडू-लाडू, गप्पू-गप्पू\"...",
  "cut": false
 },
 {
  "unit": 75,
  "start": 412.522,
  "end": 420.522,
  "hindi_on": 412.512,
  "hindi_off": 420.312,
  "dur": 8.0,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "आणि माझी कंबर! राजू द ग्रेट आज तीन वेळा पडलाय. हा चोर खूप भयंकर आहे.",
  "cut": false
 },
 {
  "unit": 76,
  "start": 421.231,
  "end": 428.401,
  "hindi_on": 421.231,
  "hindi_off": 428.671,
  "dur": 7.17,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आणि पूजेसाठी लाडू पण नाहीत. आजी किती दुःखी आहे. ती म्हणत होती, या वेळी पूजा अपूर्णच राहील.",
  "cut": false
 },
 {
  "unit": 77,
  "start": 429.182,
  "end": 435.372,
  "hindi_on": 429.182,
  "hindi_off": 434.572,
  "dur": 6.9,
  "tempo": 1.114,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "काही हरकत नाही. उद्या सकाळी नवीन प्लॅन बनवू. आपण रात्रभर जागे राहू, जोपर्यंत चोर सापडत नाही!",
  "cut": false
 },
 {
  "unit": 78,
  "start": 435.496,
  "end": 442.726,
  "hindi_on": 435.496,
  "hindi_off": 442.906,
  "dur": 7.23,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "छोटूचं पोट तर भरलं होतं. पण आता त्याच्या मनावर खूप ओझं आल्यासारखं वाटत होतं. लाडूपेक्षाही जड.",
  "cut": false
 },
 {
  "unit": 80,
  "start": 445.479,
  "end": 448.449,
  "hindi_on": 445.479,
  "hindi_off": 448.649,
  "dur": 2.97,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "नाही चमकी, नाही! ती माझी नंतरची भूक आहे!",
  "cut": false
 },
 {
  "unit": 81,
  "start": 449.606,
  "end": 452.086,
  "hindi_on": 449.606,
  "hindi_off": 453.756,
  "dur": 2.48,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "छोटू... हा तर आजीचा लाडू आहे.",
  "cut": false
 },
 {
  "unit": 82,
  "start": 454.208,
  "end": 456.498,
  "hindi_on": 454.208,
  "hindi_off": 456.858,
  "dur": 2.29,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "म्हणजे निळ्या शेपटाचा चोर...",
  "cut": false
 },
 {
  "unit": 83,
  "start": 457.311,
  "end": 460.831,
  "hindi_on": 457.311,
  "hindi_off": 462.341,
  "dur": 3.52,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "खरं तर... चोराची शेपूट नाही, खिसा आहे!",
  "cut": false
 },
 {
  "unit": 84,
  "start": 463.315,
  "end": 477.195,
  "hindi_on": 463.315,
  "hindi_off": 475.275,
  "dur": 15.95,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.025,
  "early": 0.0,
  "text": "हो! मीच सगळे लाडू खाल्ले! कोणताही जादुई चोर नाहीये. ना निळी शेपूट, ना गाणं. मला भूक लागली होती, मग भीती वाटली, म्हणून मी खोटं बोलत गेलो... सॉरी! सगळ्यांना sorry!",
  "cut": false
 },
 {
  "unit": 85,
  "start": 477.315,
  "end": 479.795,
  "hindi_on": 476.29,
  "hindi_off": 477.91,
  "dur": 2.86,
  "tempo": 1.15,
  "drift": 1.025,
  "spill": 1.597,
  "early": 0.0,
  "text": "म्हणजे... काही भूत-बीत नाहीये?",
  "cut": false
 },
 {
  "unit": 86,
  "start": 479.915,
  "end": 483.425,
  "hindi_on": 478.318,
  "hindi_off": 483.588,
  "dur": 3.51,
  "tempo": 1.0,
  "drift": 1.597,
  "spill": 0.0,
  "early": 0.0,
  "text": "नाही बबलू दादा. भूत नाही. फक्त मीच.",
  "cut": false
 },
 {
  "unit": 87,
  "start": 484.421,
  "end": 489.121,
  "hindi_on": 484.421,
  "hindi_off": 488.441,
  "dur": 4.7,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "हुश्श! थँक्यू छोटू! आता मी शांत झोपू शकेन!",
  "cut": false
 },
 {
  "unit": 88,
  "start": 489.342,
  "end": 496.012,
  "hindi_on": 489.342,
  "hindi_off": 493.782,
  "dur": 7.65,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.852,
  "early": 0.0,
  "text": "आजी, लाडू मीच खाल्ले होते. आणि नंतर खोटं बोललो. सॉरी.",
  "cut": false
 },
 {
  "unit": 89,
  "start": 496.132,
  "end": 498.612,
  "hindi_on": 494.28,
  "hindi_off": 496.47,
  "dur": 2.85,
  "tempo": 1.15,
  "drift": 1.852,
  "spill": 1.763,
  "early": 0.0,
  "text": "मले माहीत होतं बे, छोटू.",
  "cut": false
 },
 {
  "unit": 90,
  "start": 498.732,
  "end": 502.262,
  "hindi_on": 496.969,
  "hindi_off": 499.189,
  "dur": 4.06,
  "tempo": 1.15,
  "drift": 1.763,
  "spill": 2.321,
  "early": 0.0,
  "text": "माहित होतं? पण तुझा चष्मा तर...",
  "cut": false
 },
 {
  "unit": 91,
  "start": 502.382,
  "end": 514.422,
  "hindi_on": 500.061,
  "hindi_off": 511.311,
  "dur": 13.86,
  "tempo": 1.15,
  "drift": 2.321,
  "spill": 2.746,
  "early": 0.0,
  "text": "चष्मा नव्हता, पण नाक तर होतं ना बाप्पा! तुझ्या तोंडाला बेसनचा वास येत होता. मी तर फक्त तू स्वतः खरं सांगशील याचीच वाट पाहून रायले होते.",
  "cut": false
 },
 {
  "unit": 92,
  "start": 514.542,
  "end": 518.072,
  "hindi_on": 511.796,
  "hindi_off": 515.246,
  "dur": 4.06,
  "tempo": 1.15,
  "drift": 2.746,
  "spill": 2.057,
  "early": 0.0,
  "text": "आता कधीच खोटं नाही बोलणार आजी. खोटं बोलल्याने खूप थकवा येतो!",
  "cut": false
 },
 {
  "unit": 93,
  "start": 518.192,
  "end": 523.172,
  "hindi_on": 516.135,
  "hindi_off": 522.795,
  "dur": 5.14,
  "tempo": 1.031,
  "drift": 2.057,
  "spill": 0.0,
  "early": 0.0,
  "text": "चाल, आता सगळे मिळून नवीन लाडू बनवू. पूजेले अजून वेळ हाय.",
  "cut": false
 },
 {
  "unit": 94,
  "start": 523.297,
  "end": 525.827,
  "hindi_on": 523.297,
  "hindi_off": 526.997,
  "dur": 2.53,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "म्हणजे आता मला जाळं घेऊन पुन्हा पडावं नाही लागणार?",
  "cut": false
 },
 {
  "unit": 95,
  "start": 527.375,
  "end": 531.885,
  "hindi_on": 527.375,
  "hindi_off": 534.465,
  "dur": 4.51,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "नाही रे राजू, आता फक्त बेसनात हात घालायचा हाय.",
  "cut": false
 },
 {
  "unit": 96,
  "start": 535.402,
  "end": 541.572,
  "hindi_on": 535.402,
  "hindi_off": 541.172,
  "dur": 6.38,
  "tempo": 1.037,
  "drift": 0.0,
  "spill": 0.016,
  "early": 0.0,
  "text": "चला, प्लॅन बनवूया! लाडू बनवायचा प्लॅन! या वेळी प्लॅनमध्ये कसलाच प्रॉब्लेम असणार नाही!",
  "cut": false
 },
 {
  "unit": 97,
  "start": 541.692,
  "end": 546.262,
  "hindi_on": 541.676,
  "hindi_off": 545.906,
  "dur": 4.57,
  "tempo": 1.0,
  "drift": 0.016,
  "spill": 0.0,
  "early": 0.0,
  "text": "खरं तर, गुडिया, तुझ्या प्रत्येक प्लॅनमध्ये काही ना काही घोळ असतोच.",
  "cut": false
 },
 {
  "unit": 98,
  "start": 546.419,
  "end": 548.979,
  "hindi_on": 546.419,
  "hindi_off": 548.139,
  "dur": 2.56,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "तर या वेळी त्या घोळात बेसनच भरून टाकू!",
  "cut": false
 },
 {
  "unit": 99,
  "start": 549.118,
  "end": 553.648,
  "hindi_on": 549.118,
  "hindi_off": 553.338,
  "dur": 4.74,
  "tempo": 1.043,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आणि मग सुरू झाली सोनपूरची सगळ्यात भारी लाडू फॅक्टरी!",
  "cut": false
 },
 {
  "unit": 100,
  "start": 553.784,
  "end": 558.174,
  "hindi_on": 553.784,
  "hindi_off": 557.664,
  "dur": 4.39,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "खरं तर, लाडू चौकोनी बनवायला हवेत. ते जास्त टिकतात.",
  "cut": false
 },
 {
  "unit": 101,
  "start": 558.562,
  "end": 564.822,
  "hindi_on": 558.562,
  "hindi_off": 566.042,
  "dur": 6.26,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "पिंकी पोरी, लाडू गोलच चांगले वाटतात. असे गोल-गोल वळायचे, असे.",
  "cut": false
 },
 {
  "unit": 102,
  "start": 566.512,
  "end": 572.122,
  "hindi_on": 566.512,
  "hindi_off": 571.252,
  "dur": 6.19,
  "tempo": 1.106,
  "drift": 0.0,
  "spill": 0.012,
  "early": 0.0,
  "text": "बघा, राजू द ग्रेटचा सुपर लाडू! सगळ्यात मोठा!",
  "cut": false
 },
 {
  "unit": 103,
  "start": 572.242,
  "end": 575.622,
  "hindi_on": 572.23,
  "hindi_off": 575.12,
  "dur": 3.38,
  "tempo": 1.0,
  "drift": 0.012,
  "spill": 0.0,
  "early": 0.0,
  "text": "हे... हा चुरा-लाडू आहे. नवीन डिझाईन.",
  "cut": false
 },
 {
  "unit": 104,
  "start": 576.068,
  "end": 579.028,
  "hindi_on": 576.068,
  "hindi_off": 577.928,
  "dur": 2.96,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "माझे लाडू अगदी गोलमटोल बनलेत!",
  "cut": false
 },
 {
  "unit": 106,
  "start": 580.032,
  "end": 582.262,
  "hindi_on": 580.032,
  "hindi_off": 581.852,
  "dur": 2.56,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.052,
  "early": 0.0,
  "text": "अरे देवा! माझा लाडू भूत घेऊन गेलं!",
  "cut": false
 },
 {
  "unit": 107,
  "start": 582.382,
  "end": 584.112,
  "hindi_on": 582.33,
  "hindi_off": 584.51,
  "dur": 1.73,
  "tempo": 1.0,
  "drift": 0.052,
  "spill": 0.0,
  "early": 0.0,
  "text": "बबलू, ती चमकी आहे!",
  "cut": false
 },
 {
  "unit": 108,
  "start": 585.471,
  "end": 588.581,
  "hindi_on": 585.471,
  "hindi_off": 588.171,
  "dur": 3.53,
  "tempo": 1.138,
  "drift": 0.0,
  "spill": 0.009,
  "early": 0.0,
  "text": "पोटोबा, हे पूजेचे लाडू आहेत. जरा धीर धरा!",
  "cut": false
 },
 {
  "unit": 109,
  "start": 588.701,
  "end": 592.031,
  "hindi_on": 588.692,
  "hindi_off": 592.002,
  "dur": 3.33,
  "tempo": 1.0,
  "drift": 0.009,
  "spill": 0.0,
  "early": 0.0,
  "text": "वाह छोटू! आज तर तू खरोखर मोठा झालास.",
  "cut": false
 },
 {
  "unit": 110,
  "start": 592.961,
  "end": 599.271,
  "hindi_on": 592.961,
  "hindi_off": 599.631,
  "dur": 6.31,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "माझ्या जिलेब्या सुखरूप आहेत! चोर आलाच नाही. आनंदात पूजेसाठी या जिलेब्या माझ्याकडून!",
  "cut": false
 },
 {
  "unit": 111,
  "start": 600.551,
  "end": 606.801,
  "hindi_on": 600.551,
  "hindi_off": 607.191,
  "dur": 6.25,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आता सगळ्यांना प्रसाद. अन् पहिला लाडू... छोटूले, ज्यानं खरं सांगितलं.",
  "cut": false
 },
 {
  "unit": 112,
  "start": 607.703,
  "end": 613.223,
  "hindi_on": 607.703,
  "hindi_off": 614.433,
  "dur": 5.52,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "खोट्याचा लाडू पोटात जड वाटत होता. खऱ्याचा लाडू हलका-हलका अन् गोड-गोड आहे!",
  "cut": false
 },
 {
  "unit": 113,
  "start": 615.35,
  "end": 619.44,
  "hindi_on": 615.35,
  "hindi_off": 621.51,
  "dur": 4.09,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "खरं बोलणाऱ्याचं मन बी लाडूसारखं गोड राहते बाप्पा.",
  "cut": false
 },
 {
  "unit": 114,
  "start": 622.017,
  "end": 625.367,
  "hindi_on": 622.017,
  "hindi_off": 626.387,
  "dur": 3.35,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "बघा, शेरू जागा झाला! खायच्या वेळी नेहमी जागा होतो!",
  "cut": false
 },
 {
  "unit": 115,
  "start": 627.297,
  "end": 630.777,
  "hindi_on": 627.297,
  "hindi_off": 630.917,
  "dur": 3.48,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "अरे देवा, माहा चष्मा परत कुठं गेला?",
  "cut": false
 },
 {
  "unit": 116,
  "start": 631.431,
  "end": 633.721,
  "hindi_on": 631.431,
  "hindi_off": 634.231,
  "dur": 2.29,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आजी, त्याला जादुई चष्मा चोर घेऊन गेला!",
  "cut": false
 },
 {
  "unit": 117,
  "start": 634.745,
  "end": 638.165,
  "hindi_on": 634.745,
  "hindi_off": 637.535,
  "dur": 3.42,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "नाही-नाही, खरं सांगेन — तो तुझ्या डोक्यावरच आहे!",
  "cut": false
 },
 {
  "unit": 118,
  "start": 638.504,
  "end": 640.434,
  "hindi_on": 638.504,
  "hindi_off": 640.964,
  "dur": 1.93,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "आता मात्र मला मनापासून भूक लागलीये!",
  "cut": false
 }
]