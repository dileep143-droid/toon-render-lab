[
 {
  "unit": 0,
  "start": 0.431,
  "end": 16.561,
  "hindi_on": 0.431,
  "hindi_off": 11.881,
  "dur": 18.55,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 4.334,
  "early": 0.0,
  "text": "ഇതാണ് സോൺപൂർ ഗ്രാമം. ഇത് മുത്തശ്ശിയുടെ നടുമുറ്റം! ഇന്ന് വൈകീട്ട് ഇവിടെ പൂജയുണ്ട്, മുത്തശ്ശി ഉണ്ടാക്കുകയാണ് തന്റെ പ്രശസ്തമായ കടലമാവ് ലഡു!",
  "cut": false
 },
 {
  "unit": 1,
  "start": 16.681,
  "end": 21.231,
  "hindi_on": 12.347,
  "hindi_off": 20.457,
  "dur": 4.71,
  "tempo": 1.037,
  "drift": 4.334,
  "spill": 0.01,
  "early": 0.0,
  "text": "ഒന്നു, രണ്ടു, മൂന്നു... പതിനൊന്നു ലഡു! പൂജയ്ക്ക് ഇത് ധാരാളം മതിട്ടാ!",
  "cut": false
 },
 {
  "unit": 2,
  "start": 21.351,
  "end": 26.811,
  "hindi_on": 21.341,
  "hindi_off": 29.251,
  "dur": 5.46,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "ആഹാ... എന്ത് നല്ല മണം! മുത്തശ്ശീ, എനിക്ക് വിശക്കുന്നു!",
  "cut": false
 },
 {
  "unit": 3,
  "start": 29.755,
  "end": 33.285,
  "hindi_on": 29.755,
  "hindi_off": 32.485,
  "dur": 3.74,
  "tempo": 1.059,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "നീയിപ്പൊ നാലു പൊറോട്ട കഴിച്ചതല്ലേ ഉള്ളൂ, ചോറ്റൂ!",
  "cut": false
 },
 {
  "unit": 4,
  "start": 33.408,
  "end": 36.208,
  "hindi_on": 33.408,
  "hindi_off": 36.548,
  "dur": 2.8,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അത് രാവിലത്തെ വിശപ്പല്ലേ. ഇത് ഇപ്പോഴത്തെ വിശപ്പാ!",
  "cut": false
 },
 {
  "unit": 5,
  "start": 37.047,
  "end": 44.947,
  "hindi_on": 37.047,
  "hindi_off": 44.487,
  "dur": 7.9,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഈ ലഡു ഭഗവാനുള്ളതാട്ടാ. പൂജ കഴിഞ്ഞേ എല്ലാവർക്കും തരുള്ളൂ. അതുവരെ ആരും തൊടരുത്, കേട്ടോടാ ക്ടാവേ?",
  "cut": false
 },
 {
  "unit": 6,
  "start": 45.432,
  "end": 47.612,
  "hindi_on": 45.432,
  "hindi_off": 47.542,
  "dur": 2.18,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "മനസ്സിലായി മുത്തശ്ശീ! ഞാൻ തൊടില്ല!",
  "cut": false
 },
 {
  "unit": 7,
  "start": 55.495,
  "end": 61.305,
  "hindi_on": 55.495,
  "hindi_off": 59.305,
  "dur": 6.28,
  "tempo": 1.082,
  "drift": 0.0,
  "spill": 0.006,
  "early": 0.0,
  "text": "അയ്യോ, എന്റെ കണ്ണട എവ്ടെപ്പോയി? ഇപ്പോ ഇവിടെ ഇണ്ടായിരുന്നല്ലോ!",
  "cut": false
 },
 {
  "unit": 9,
  "start": 61.425,
  "end": 67.435,
  "hindi_on": 61.419,
  "hindi_off": 67.079,
  "dur": 6.01,
  "tempo": 1.0,
  "drift": 0.006,
  "spill": 0.0,
  "early": 0.0,
  "text": "ചമ്മകീ, നീയൊന്നും പറയില്ലല്ലേ. ന്നാ ശരി, ഞാനൊന്നു കിടക്കട്ടെട്ടാ.",
  "cut": false
 },
 {
  "unit": 10,
  "start": 67.935,
  "end": 76.355,
  "hindi_on": 67.935,
  "hindi_off": 75.965,
  "dur": 8.97,
  "tempo": 1.067,
  "drift": 0.0,
  "spill": 0.01,
  "early": 0.0,
  "text": "ഉച്ചയായി. മുത്തശ്ശി ഉറങ്ങി. ഷേരു ഉറങ്ങി. പക്ഷേ ചോറ്റുവിന്റെ വയറ്... ഉറങ്ങിയില്ലേ ഉറങ്ങിയില്ല!",
  "cut": false
 },
 {
  "unit": 11,
  "start": 76.475,
  "end": 78.945,
  "hindi_on": 76.465,
  "hindi_off": 79.725,
  "dur": 2.47,
  "tempo": 1.0,
  "drift": 0.01,
  "spill": 0.0,
  "early": 0.0,
  "text": "ശ്ശ്, വയറേ മിണ്ടാതിരിക്ക്! മുത്തശ്ശി ഉണരും!",
  "cut": false
 },
 {
  "unit": 12,
  "start": 80.678,
  "end": 85.908,
  "hindi_on": 80.678,
  "hindi_off": 84.518,
  "dur": 5.99,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.989,
  "early": 0.0,
  "text": "മുത്തശ്ശി പറഞ്ഞത് കൈവെക്കരുതെന്നല്ലേ, അപ്പോ ഞാൻ... വായ വെക്കും!",
  "cut": false
 },
 {
  "unit": 13,
  "start": 86.028,
  "end": 87.548,
  "hindi_on": 85.039,
  "hindi_off": 87.109,
  "dur": 1.73,
  "tempo": 1.15,
  "drift": 0.989,
  "spill": 0.043,
  "early": 0.0,
  "text": "ഉം... ഒരെണ്ണം മാത്രം. ഒരേയൊരെണ്ണം.",
  "cut": false
 },
 {
  "unit": 14,
  "start": 87.668,
  "end": 91.768,
  "hindi_on": 87.625,
  "hindi_off": 91.555,
  "dur": 4.1,
  "tempo": 1.0,
  "drift": 0.043,
  "spill": 0.0,
  "early": 0.0,
  "text": "\"ഒരെണ്ണം മാത്രം\" എന്ന് പറഞ്ഞുപറഞ്ഞ് ചോറ്റു എണ്ണാൻ തന്നെ മറന്നു!",
  "cut": false
 },
 {
  "unit": 15,
  "start": 92.497,
  "end": 95.017,
  "hindi_on": 92.497,
  "hindi_off": 95.487,
  "dur": 2.52,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇത് പിന്നെ കഴിക്കാൻ. ശേഷമുള്ള വിശപ്പിന്!",
  "cut": false
 },
 {
  "unit": 16,
  "start": 95.975,
  "end": 101.045,
  "hindi_on": 95.975,
  "hindi_off": 98.705,
  "dur": 5.07,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അയ്യോ ഷേരു, ഉറങ്ങിക്കോ! നീ ഒന്നും കണ്ടിട്ടില്ല കേട്ടോ!",
  "cut": false
 },
 {
  "unit": 17,
  "start": 102.067,
  "end": 107.267,
  "hindi_on": 102.067,
  "hindi_off": 106.587,
  "dur": 5.2,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്റെ ഈശ്വരാ! എന്റെ ലഡു! പ്ലേറ്റ് കാലിയാണല്ലോട്ടാ!",
  "cut": false
 },
 {
  "unit": 18,
  "start": 107.527,
  "end": 109.927,
  "hindi_on": 107.527,
  "hindi_off": 110.697,
  "dur": 2.4,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്താ? പതിനൊന്നു ലഡുവും കാണാനില്ലേ?",
  "cut": false
 },
 {
  "unit": 19,
  "start": 111.655,
  "end": 113.985,
  "hindi_on": 111.655,
  "hindi_off": 113.605,
  "dur": 2.41,
  "tempo": 1.034,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്ത പറ്റി മുത്തശ്ശീ? എന്തെങ്കിലും പ്രശ്നമുണ്ടോ?",
  "cut": false
 },
 {
  "unit": 20,
  "start": 114.106,
  "end": 116.846,
  "hindi_on": 114.106,
  "hindi_off": 117.886,
  "dur": 2.74,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ചോറ്റൂ... നിന്റെ ചുണ്ടത്ത് ഈ മഞ്ഞ നിറത്തിൽ എന്താ?",
  "cut": false
 },
 {
  "unit": 21,
  "start": 118.806,
  "end": 122.446,
  "hindi_on": 118.806,
  "hindi_off": 123.676,
  "dur": 3.64,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇതോ? ഇത്... എന്റെ പുതിയ മീശയാ! സാറിന്റെ മീശ പോലെ!",
  "cut": false
 },
 {
  "unit": 22,
  "start": 124.131,
  "end": 128.481,
  "hindi_on": 124.131,
  "hindi_off": 128.371,
  "dur": 4.35,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എനിക്ക് കണ്ണടയില്ലാതെ ഒന്നും കാണാൻ പറ്റണില്ലല്ലോട്ടാ.",
  "cut": false
 },
 {
  "unit": 23,
  "start": 129.302,
  "end": 133.652,
  "hindi_on": 129.302,
  "hindi_off": 133.532,
  "dur": 4.35,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "മുത്തശ്ശീ! ഞാൻ കണ്ടു! ഒരു... മാന്ത്രിക ലഡു കള്ളൻ വന്നതാണ്!",
  "cut": false
 },
 {
  "unit": 24,
  "start": 134.066,
  "end": 135.486,
  "hindi_on": 134.066,
  "hindi_off": 136.496,
  "dur": 1.42,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "മാന്ത്രിക ലഡു കള്ളനോ?",
  "cut": false
 },
 {
  "unit": 25,
  "start": 137.391,
  "end": 142.461,
  "hindi_on": 137.391,
  "hindi_off": 143.001,
  "dur": 5.07,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അതേ! ജനലിലൂടെ പറന്നുവന്ന് തളികയിൽ ചാടി ഒരൊറ്റ വിഴുങ്ങലിൽ ലഡു മുഴുവൻ തിന്നു!",
  "cut": false
 },
 {
  "unit": 26,
  "start": 143.93,
  "end": 147.44,
  "hindi_on": 143.93,
  "hindi_off": 147.58,
  "dur": 3.51,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ആഹാ! എന്നിട്ട് ആ കള്ളൻ കാണാൻ എങ്ങനെ ഇണ്ടായിരുന്നു?",
  "cut": false
 },
 {
  "unit": 27,
  "start": 148.027,
  "end": 151.387,
  "hindi_on": 148.027,
  "hindi_off": 152.777,
  "dur": 3.36,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അവൻ... അവനെ... കാണാൻ കഴിയില്ല! മാന്ത്രികനായതുകൊണ്ടാ!",
  "cut": false
 },
 {
  "unit": 28,
  "start": 153.7,
  "end": 156.52,
  "hindi_on": 153.7,
  "hindi_off": 156.17,
  "dur": 2.82,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പക്ഷേ ചോറ്റൂ, ജനൽ രാവിലെയേ അടച്ചതാണല്ലോ.",
  "cut": false
 },
 {
  "unit": 29,
  "start": 156.647,
  "end": 159.477,
  "hindi_on": 156.647,
  "hindi_off": 160.087,
  "dur": 2.83,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്നാലവൻ അടച്ച ജനലിലൂടെയും കടക്കും! കാറ്റുപോലെ! പടപടാ!",
  "cut": false
 },
 {
  "unit": 30,
  "start": 161.059,
  "end": 163.489,
  "hindi_on": 161.059,
  "hindi_off": 164.189,
  "dur": 2.43,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ന്നാ അപ്പോ നീ എവ്ടെയായിരുന്നു, ചോറ്റൂ?",
  "cut": false
 },
 {
  "unit": 31,
  "start": 164.656,
  "end": 169.476,
  "hindi_on": 164.656,
  "hindi_off": 169.036,
  "dur": 4.97,
  "tempo": 1.03,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഞാനോ? ഞാൻ... ഷേരുവിന്റെ കൂടെ ഉറങ്ങുകയായിരുന്നു! അല്ലേ ഷേരു?",
  "cut": false
 },
 {
  "unit": 32,
  "start": 169.602,
  "end": 171.962,
  "hindi_on": 169.602,
  "hindi_off": 171.202,
  "dur": 2.36,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "കണ്ടോ? ഷേരുവും \"അതെ\" എന്ന് പറയുന്നുണ്ട്!",
  "cut": false
 },
 {
  "unit": 33,
  "start": 172.128,
  "end": 183.138,
  "hindi_on": 172.128,
  "hindi_off": 182.858,
  "dur": 11.01,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അങ്ങനെ ചോറ്റുവിന്റെ ആദ്യ അസത്യം തുടങ്ങി! പാവത്തിനറിയില്ലല്ലോ, അസത്യവും ലഡു പോലെയാണെന്ന് — ഒരെണ്ണം പറഞ്ഞാൽ വേറെയും പറയേണ്ടിവരും!",
  "cut": false
 },
 {
  "unit": 34,
  "start": 183.784,
  "end": 191.624,
  "hindi_on": 183.784,
  "hindi_off": 191.574,
  "dur": 7.84,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "കൂട്ടുകാരേ, സോൺപൂരിൽ ഒരു മാന്ത്രിക ലഡു കള്ളൻ നടക്കുന്നുണ്ട്. വൈകീട്ട് പൂജയാണ്. അവനെ പിടിക്കണം. വാ, പ്ലാൻ ഉണ്ടാക്കാം!",
  "cut": false
 },
 {
  "unit": 35,
  "start": 192.548,
  "end": 197.518,
  "hindi_on": 192.548,
  "hindi_off": 197.428,
  "dur": 4.97,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "സത്യത്തിൽ, ഞാൻ പുസ്തകത്തിൽ വായിച്ചിട്ടുണ്ട് ലഡു കള്ളന്മാർ ചൊവ്വാഴ്ച മാത്രമേ വരൂ എന്ന്.",
  "cut": false
 },
 {
  "unit": 36,
  "start": 198.376,
  "end": 200.256,
  "hindi_on": 198.376,
  "hindi_off": 200.306,
  "dur": 1.88,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പിങ്കീ, ഇന്ന് ബുധനാഴ്ചയാണല്ലോ!",
  "cut": false
 },
 {
  "unit": 37,
  "start": 200.824,
  "end": 204.214,
  "hindi_on": 200.824,
  "hindi_off": 206.844,
  "dur": 3.39,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അപ്പോ... സത്യത്തിൽ, അവൻ ഓവർടൈം ജോലി ചെയ്യുകയാവും!",
  "cut": false
 },
 {
  "unit": 38,
  "start": 207.747,
  "end": 211.917,
  "hindi_on": 207.747,
  "hindi_off": 211.537,
  "dur": 4.54,
  "tempo": 1.09,
  "drift": 0.0,
  "spill": 0.003,
  "early": 0.0,
  "text": "മാന്ത്രികനോ? കണ്ണിൽ കാണില്ലേ? അപ്പോ... പ്രേതം!",
  "cut": false
 },
 {
  "unit": 39,
  "start": 212.037,
  "end": 214.387,
  "hindi_on": 212.034,
  "hindi_off": 214.754,
  "dur": 2.35,
  "tempo": 1.0,
  "drift": 0.003,
  "spill": 0.0,
  "early": 0.0,
  "text": "ബബ്ലൂ ഏട്ടാ, എന്റെ പുറകിൽ നിങ്ങൾക്ക് ഒളിക്കാൻ പറ്റില്ല!",
  "cut": false
 },
 {
  "unit": 40,
  "start": 215.716,
  "end": 220.476,
  "hindi_on": 215.716,
  "hindi_off": 221.546,
  "dur": 4.76,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പേടിക്കണ്ട! രാജു ദ ഗ്രേറ്റ് വന്നു കഴിഞ്ഞു! ഏത് കള്ളനെയും ഈ വലയിൽ കുടുക്കും!",
  "cut": false
 },
 {
  "unit": 41,
  "start": 222.488,
  "end": 226.868,
  "hindi_on": 222.488,
  "hindi_off": 228.838,
  "dur": 4.38,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇത്... ഇതൊരു പരീക്ഷണമായിരുന്നു! വല കൃത്യമായി വീഴുന്നുണ്ട്.",
  "cut": false
 },
 {
  "unit": 42,
  "start": 229.739,
  "end": 235.479,
  "hindi_on": 229.739,
  "hindi_off": 235.239,
  "dur": 5.74,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ചോറ്റൂ, നീ കള്ളനെ കണ്ടതല്ലേ. പറ, അവന് വേറെ എന്തൊക്കെ അടയാളമുണ്ട്?",
  "cut": false
 },
 {
  "unit": 43,
  "start": 235.761,
  "end": 240.271,
  "hindi_on": 235.761,
  "hindi_off": 238.301,
  "dur": 5.2,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.574,
  "early": 0.0,
  "text": "അടയാളമോ? ഉം... അവന്... നീല നിറത്തിലൊരു വാലുണ്ട്!",
  "cut": false
 },
 {
  "unit": 44,
  "start": 240.391,
  "end": 241.921,
  "hindi_on": 238.817,
  "hindi_off": 240.827,
  "dur": 1.73,
  "tempo": 1.15,
  "drift": 1.574,
  "spill": 0.272,
  "early": 0.0,
  "text": "നീല വാൽ. പിന്നെ?",
  "cut": false
 },
 {
  "unit": 45,
  "start": 242.041,
  "end": 247.661,
  "hindi_on": 241.769,
  "hindi_off": 248.489,
  "dur": 5.62,
  "tempo": 1.0,
  "drift": 0.272,
  "spill": 0.0,
  "early": 0.0,
  "text": "പിന്നെ അവൻ ഉരുണ്ട സാധനങ്ങളേ തിന്നൂ. ലഡു, പാനിപൂരി, പന്ത്...",
  "cut": false
 },
 {
  "unit": 46,
  "start": 248.953,
  "end": 251.743,
  "hindi_on": 248.953,
  "hindi_off": 250.403,
  "dur": 3.2,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.987,
  "early": 0.0,
  "text": "പന്തോ? എന്റെ ക്രിക്കറ്റ് പന്ത്!",
  "cut": false
 },
 {
  "unit": 47,
  "start": 251.863,
  "end": 255.913,
  "hindi_on": 250.876,
  "hindi_off": 255.096,
  "dur": 4.08,
  "tempo": 1.005,
  "drift": 0.987,
  "spill": 0.0,
  "early": 0.0,
  "text": "തിന്നുമ്പോൾ അവൻ പാട്ടും പാടും — \"ലഡു-ലഡു, ഗപ്പു-ഗപ്പു!\"",
  "cut": false
 },
 {
  "unit": 48,
  "start": 256.043,
  "end": 263.143,
  "hindi_on": 256.043,
  "hindi_off": 265.563,
  "dur": 7.1,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അവൻ ഉരുണ്ട സാധനങ്ങൾ കഴിക്കുമെങ്കിൽ, ഉരുണ്ട സാധനം വെച്ച് തന്നെ കുടുക്കാം! ലല്ലൻ അമ്മാവന്റെ കടയിൽ നിന്ന് ലഡു വാങ്ങി ആൽത്തറയിൽ വെച്ച് വല വിരിക്കാം!",
  "cut": false
 },
 {
  "unit": 49,
  "start": 266.045,
  "end": 269.225,
  "hindi_on": 266.045,
  "hindi_off": 269.715,
  "dur": 3.18,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "കലക്കൻ പ്ലാൻ! പക്ഷേ ആദ്യം എന്നെ ഈ വലയിൽ നിന്ന് പുറത്തിറക്ക്!",
  "cut": false
 },
 {
  "unit": 50,
  "start": 273.624,
  "end": 283.324,
  "hindi_on": 273.624,
  "hindi_off": 282.874,
  "dur": 9.7,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "കണ്ടോ? ഒരു കളവിൽ നിന്ന് നീല വാലുണ്ടായി, വാലിൽ നിന്ന് പാട്ടുണ്ടായി. ചോറ്റുവിന്റെ കള്ളം ആൽമരത്തിനേക്കാൾ വലുതായി വളർന്നു!",
  "cut": false
 },
 {
  "unit": 51,
  "start": 284.077,
  "end": 290.857,
  "hindi_on": 284.077,
  "hindi_off": 290.477,
  "dur": 7.49,
  "tempo": 1.105,
  "drift": 0.0,
  "spill": 0.004,
  "early": 0.0,
  "text": "എന്റെ ഉരുണ്ടുസുന്ദര മക്കളേ! വെയിലത്ത് ഇരിക്കരുത്, കരിഞ്ഞുപോകും. വാ, പഞ്ചസാരപ്പാനിയിൽ ഒരു മുങ്ങാംകുഴിയിടാം!",
  "cut": false
 },
 {
  "unit": 52,
  "start": 290.977,
  "end": 296.857,
  "hindi_on": 290.973,
  "hindi_off": 296.043,
  "dur": 6.12,
  "tempo": 1.041,
  "drift": 0.004,
  "spill": 0.0,
  "early": 0.0,
  "text": "ലല്ലൻ അമ്മാവാ, നാലു ലഡു വേണം. മാന്ത്രിക ലഡു കള്ളനെ കുടുക്കാൻ വല വിരിക്കുകയാണ്!",
  "cut": false
 },
 {
  "unit": 53,
  "start": 296.978,
  "end": 300.178,
  "hindi_on": 296.978,
  "hindi_off": 300.938,
  "dur": 3.2,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്താ? ലഡു കള്ളനോ? നമ്മുടെ നാട്ടിലോ?",
  "cut": false
 },
 {
  "unit": 54,
  "start": 301.394,
  "end": 307.134,
  "hindi_on": 301.394,
  "hindi_off": 307.034,
  "dur": 5.74,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അയ്യോ! എന്റെ കുഞ്ഞുങ്ങളെ ആരും തൊടരുത്! ജിലേബി റാണീ, പേടിക്കണ്ട, അമ്മാവനുണ്ട്!",
  "cut": false
 },
 {
  "unit": 55,
  "start": 307.942,
  "end": 310.562,
  "hindi_on": 307.942,
  "hindi_off": 310.692,
  "dur": 2.62,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പേടിക്കണ്ട അമ്മാവാ, രാജു ദ ഗ്രേറ്റ് കൂടെയുണ്ടല്ലോ!",
  "cut": false
 },
 {
  "unit": 56,
  "start": 311.191,
  "end": 315.161,
  "hindi_on": 311.191,
  "hindi_off": 315.991,
  "dur": 3.97,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇത്... ഇതും പ്ലാനിന്റെ ഭാഗമാ! കൈയിൽ മധുരമുണ്ടെങ്കിലേ കള്ളൻ വരൂ!",
  "cut": false
 },
 {
  "unit": 57,
  "start": 316.964,
  "end": 323.994,
  "hindi_on": 316.964,
  "hindi_off": 325.244,
  "dur": 7.03,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ദാ നാലു ലഡു. സ്നേഹത്തോടെ നോക്കണം കേട്ടോ. വളരെ പാവം മക്കളാ, ചീനച്ചട്ടിയിൽ നിന്ന് പുറത്തുപോലും ചാടില്ല!",
  "cut": false
 },
 {
  "unit": 58,
  "start": 325.759,
  "end": 329.029,
  "hindi_on": 325.759,
  "hindi_off": 328.549,
  "dur": 3.27,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഉറപ്പായും അമ്മാവാ! കള്ളനെ പിടിച്ച ഉടനെ തിരിച്ചുകൊണ്ടുവരാം!",
  "cut": false
 },
 {
  "unit": 59,
  "start": 329.516,
  "end": 331.656,
  "hindi_on": 329.516,
  "hindi_off": 331.536,
  "dur": 2.14,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അമ്മാവാ, എനിക്ക് വിശക്കുന്നു!",
  "cut": false
 },
 {
  "unit": 60,
  "start": 332.013,
  "end": 334.893,
  "hindi_on": 332.013,
  "hindi_off": 334.863,
  "dur": 2.88,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ചോറ്റൂ! ഇത് കള്ളനുള്ളതാ, നിനക്കുള്ളതല്ല!",
  "cut": false
 },
 {
  "unit": 61,
  "start": 335.78,
  "end": 341.77,
  "hindi_on": 335.78,
  "hindi_off": 342.15,
  "dur": 5.99,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പ്ലാൻ ഇതാണ് — കള്ളൻ ലഡു തിന്നാൻ വരുമ്പോൾ ഞാൻ കയർ വലിക്കും, വല വീഴും, കള്ളൻ കുടുങ്ങും!",
  "cut": false
 },
 {
  "unit": 62,
  "start": 342.604,
  "end": 347.754,
  "hindi_on": 342.604,
  "hindi_off": 347.354,
  "dur": 5.19,
  "tempo": 1.007,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഗുഡിയാ, പക്ഷേ കള്ളനെ കാണാൻ കഴിയില്ലല്ലോ. വല വീണാൽ അകത്ത് ആളുണ്ടെന്ന് എങ്ങനെയറിയും?",
  "cut": false
 },
 {
  "unit": 63,
  "start": 347.879,
  "end": 352.129,
  "hindi_on": 347.879,
  "hindi_off": 352.099,
  "dur": 4.25,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഉം... അത്... പ്ലാനിന്റെ ആ ഭാഗം ഞാൻ നാളെ തീരുമാനിക്കാം.",
  "cut": false
 },
 {
  "unit": 64,
  "start": 353.012,
  "end": 355.972,
  "hindi_on": 353.012,
  "hindi_off": 355.972,
  "dur": 2.96,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "കേൾക്കൂ! കൊറിക്കുന്ന ശബ്ദം! കള്ളൻ വന്നു!",
  "cut": false
 },
 {
  "unit": 65,
  "start": 356.436,
  "end": 358.886,
  "hindi_on": 356.436,
  "hindi_off": 359.056,
  "dur": 2.45,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പിടിച്ചേ! രാജു ദ ഗ്രേറ്റ് കള്ളനെ പിടിച്ചേ!",
  "cut": false
 },
 {
  "unit": 66,
  "start": 360.006,
  "end": 365.316,
  "hindi_on": 360.006,
  "hindi_off": 365.256,
  "dur": 5.31,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "സത്യത്തിൽ... കള്ളന്റെ വാൽ നീലയല്ല, തവിട്ടുനിറമാണ്. ഇത് കുരയ്ക്കുകയും ചെയ്യുന്നു!",
  "cut": false
 },
 {
  "unit": 67,
  "start": 365.776,
  "end": 368.886,
  "hindi_on": 365.776,
  "hindi_off": 368.306,
  "dur": 3.11,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പിങ്കീ, ഇത് കള്ളനല്ല, ഷേരുവാ!",
  "cut": false
 },
 {
  "unit": 68,
  "start": 369.245,
  "end": 371.175,
  "hindi_on": 369.245,
  "hindi_off": 371.405,
  "dur": 1.93,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പ്രേതം! പ്രേതമേ!",
  "cut": false
 },
 {
  "unit": 69,
  "start": 371.886,
  "end": 378.056,
  "hindi_on": 371.886,
  "hindi_off": 377.846,
  "dur": 6.17,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഡാ ക്ടാവുകളേ, ഇത് ഞാനാട്ടാ! എന്റെ കണ്ണട തിരയുകയായിരുന്നു. ആരെങ്കിലും കണ്ടോ?",
  "cut": false
 },
 {
  "unit": 70,
  "start": 378.779,
  "end": 385.189,
  "hindi_on": 378.779,
  "hindi_off": 388.259,
  "dur": 6.41,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "മക്കളേ, ഞാനും വന്നു! കള്ളൻ എന്റെ ജിലേബിയിൽ തൊട്ടാൽ ഈ അപ്പക്കുഴവി വെച്ച് പെരുമാറും!",
  "cut": false
 },
 {
  "unit": 71,
  "start": 389.157,
  "end": 391.857,
  "hindi_on": 389.157,
  "hindi_off": 391.557,
  "dur": 2.7,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അമ്മാവാ, കള്ളനെ കണ്ടുകിട്ടിയില്ല!",
  "cut": false
 },
 {
  "unit": 72,
  "start": 392.501,
  "end": 398.061,
  "hindi_on": 392.501,
  "hindi_off": 398.211,
  "dur": 5.56,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അവൻ... അവൻ ലല്ലൻ അമ്മാവന്റെ കടയുടെ ഭാഗത്തേക്ക് പോയിക്കാണും! നീല വാൽ അങ്ങോട്ട് പോകുന്നത് ഞാൻ കണ്ടു!",
  "cut": false
 },
 {
  "unit": 73,
  "start": 398.707,
  "end": 403.307,
  "hindi_on": 398.707,
  "hindi_off": 404.167,
  "dur": 4.6,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അയ്യോ! എന്റെ ജിലേബികൾ ഒറ്റയ്ക്കാണല്ലോ! ഞാൻ ദാ വന്നു മക്കളേ!",
  "cut": false
 },
 {
  "unit": 74,
  "start": 405.062,
  "end": 411.362,
  "hindi_on": 405.062,
  "hindi_off": 412.012,
  "dur": 6.3,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എനിക്ക് ഇനി രാത്രി ഉറങ്ങാൻ പറ്റില്ല! നീല വാലുള്ള പ്രേതം പാട്ടുപാടും — \"ലഡു-ലഡു, ഗപ്പു-ഗപ്പു!\"",
  "cut": false
 },
 {
  "unit": 75,
  "start": 412.512,
  "end": 419.962,
  "hindi_on": 412.512,
  "hindi_off": 420.312,
  "dur": 7.45,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്റെ അരക്കെട്ട് പോയി! രാജു ദ ഗ്രേറ്റ് ഇന്ന് മൂന്നു തവണ വീണു! കള്ളൻ വലിയ അപകടകാരിയാ!",
  "cut": false
 },
 {
  "unit": 76,
  "start": 421.231,
  "end": 428.361,
  "hindi_on": 421.231,
  "hindi_off": 428.671,
  "dur": 7.13,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പൂജയ്ക്ക് ലഡുവുമില്ല! മുത്തശ്ശിക്ക് ഭയങ്കര സങ്കടമായി. ഇത്തവണ പൂജ അപൂർണ്ണമാകുമെന്നാണ് പറഞ്ഞത്.",
  "cut": false
 },
 {
  "unit": 77,
  "start": 429.182,
  "end": 435.362,
  "hindi_on": 429.182,
  "hindi_off": 434.572,
  "dur": 6.25,
  "tempo": 1.009,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "സാരമില്ല. നാളെ രാവിലെ പുതിയ പ്ലാൻ ഉണ്ടാക്കാം. കള്ളനെ കിട്ടുന്നതുവരെ രാത്രി മുഴുവൻ ഉണർന്നിരിക്കും!",
  "cut": false
 },
 {
  "unit": 78,
  "start": 435.496,
  "end": 442.956,
  "hindi_on": 435.496,
  "hindi_off": 442.906,
  "dur": 7.46,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ചോറ്റുവിന്റെ വയറു നിറഞ്ഞിരുന്നു. പക്ഷേ മനസ്സിന് വലിയ വിഷമം തോന്നി. ലഡുവിനേക്കാൾ ഭാരമുള്ള വിഷമം!",
  "cut": false
 },
 {
  "unit": 80,
  "start": 445.479,
  "end": 448.479,
  "hindi_on": 445.479,
  "hindi_off": 448.649,
  "dur": 3.0,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "വേണ്ട ചമ്മകീ, വേണ്ട! അത് പിന്നെ കഴിക്കാനുള്ളതാ!",
  "cut": false
 },
 {
  "unit": 81,
  "start": 449.606,
  "end": 452.466,
  "hindi_on": 449.606,
  "hindi_off": 453.756,
  "dur": 2.86,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ചോറ്റൂ... ഇത് മുത്തശ്ശിയുടെ ലഡുവാണല്ലോ!",
  "cut": false
 },
 {
  "unit": 82,
  "start": 454.208,
  "end": 456.558,
  "hindi_on": 454.208,
  "hindi_off": 456.858,
  "dur": 2.35,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അപ്പോ ആ നീല വാലുള്ള കള്ളൻ...",
  "cut": false
 },
 {
  "unit": 83,
  "start": 457.311,
  "end": 460.781,
  "hindi_on": 457.311,
  "hindi_off": 462.341,
  "dur": 3.47,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "സത്യത്തിൽ... കള്ളന് വാലല്ല, പോക്കറ്റാണുള്ളത്!",
  "cut": false
 },
 {
  "unit": 84,
  "start": 463.315,
  "end": 477.305,
  "hindi_on": 463.315,
  "hindi_off": 475.275,
  "dur": 16.08,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 1.135,
  "early": 0.0,
  "text": "അതേ! ഞാൻ തന്നെയാണ് ലഡു മുഴുവൻ തിന്നത്! ഒരു മാന്ത്രിക കള്ളനുമില്ല. നീല വാലുമില്ല, പാട്ടുമില്ല. വിശന്നപ്പോൾ എടുത്തു, പേടിയായപ്പോൾ കളവു പറഞ്ഞു... സോറി! എല്ലാവരോടും ഐ ആം ദി സോറി അളിയാ!",
  "cut": false
 },
 {
  "unit": 85,
  "start": 477.425,
  "end": 479.305,
  "hindi_on": 476.29,
  "hindi_off": 477.91,
  "dur": 2.16,
  "tempo": 1.15,
  "drift": 1.135,
  "spill": 1.107,
  "early": 0.0,
  "text": "അപ്പോ... പ്രേതമൊന്നും ഇല്ലേ?",
  "cut": false
 },
 {
  "unit": 86,
  "start": 479.425,
  "end": 482.705,
  "hindi_on": 478.318,
  "hindi_off": 483.588,
  "dur": 3.28,
  "tempo": 1.0,
  "drift": 1.107,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇല്ല ബബ്ലൂ ഏട്ടാ, പ്രേതമൊന്നുമില്ല. ഞാൻ മാത്രം.",
  "cut": false
 },
 {
  "unit": 87,
  "start": 484.421,
  "end": 489.231,
  "hindi_on": 484.421,
  "hindi_off": 488.441,
  "dur": 4.92,
  "tempo": 1.025,
  "drift": 0.0,
  "spill": 0.009,
  "early": 0.0,
  "text": "ഹമ്മോ! താങ്ക്യൂ ചോറ്റൂ! എനിക്കിനി സമാധാനമായി ഉറങ്ങാം!",
  "cut": false
 },
 {
  "unit": 88,
  "start": 489.351,
  "end": 494.891,
  "hindi_on": 489.342,
  "hindi_off": 493.782,
  "dur": 6.37,
  "tempo": 1.15,
  "drift": 0.009,
  "spill": 0.731,
  "early": 0.0,
  "text": "മുത്തശ്ശീ, ലഡു തിന്നത് ഞാനാ. എന്നിട്ട് കള്ളവും പറഞ്ഞു. എന്നോട് ക്ഷമിക്കണം!",
  "cut": false
 },
 {
  "unit": 89,
  "start": 495.011,
  "end": 496.951,
  "hindi_on": 494.28,
  "hindi_off": 496.47,
  "dur": 2.22,
  "tempo": 1.15,
  "drift": 0.731,
  "spill": 0.102,
  "early": 0.0,
  "text": "എനിക്കറിയാമായിരുന്നു, ചോറ്റൂ!",
  "cut": false
 },
 {
  "unit": 90,
  "start": 497.071,
  "end": 499.991,
  "hindi_on": 496.969,
  "hindi_off": 499.189,
  "dur": 3.35,
  "tempo": 1.15,
  "drift": 0.102,
  "spill": 0.05,
  "early": 0.0,
  "text": "അറിയാമായിരുന്നോ? പക്ഷേ മുത്തശ്ശിയുടെ കണ്ണട...",
  "cut": false
 },
 {
  "unit": 91,
  "start": 500.111,
  "end": 510.421,
  "hindi_on": 500.061,
  "hindi_off": 511.311,
  "dur": 10.31,
  "tempo": 1.0,
  "drift": 0.05,
  "spill": 0.0,
  "early": 0.0,
  "text": "കണ്ണടയില്ലെങ്കിലും മൂക്കുണ്ടായിരുന്നല്ലോടാ! നിന്റെ വായയിൽ നിന്ന് കടലമാവിന്റെ മണം വരുന്നുണ്ടായിരുന്നു. നീ സ്വയം സത്യം പറയട്ടെയെന്ന് കരുതി കാത്തിരുന്നതാട്ടാ!",
  "cut": false
 },
 {
  "unit": 92,
  "start": 511.796,
  "end": 516.026,
  "hindi_on": 511.796,
  "hindi_off": 515.246,
  "dur": 4.85,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 0.011,
  "early": 0.0,
  "text": "ഇനി ഞാൻ കള്ളം പറയേയില്ല മുത്തശ്ശീ! കള്ളം പറയുമ്പോൾ മനസ്സിന് ഭയങ്കര വിഷമമാ!",
  "cut": false
 },
 {
  "unit": 93,
  "start": 516.146,
  "end": 522.646,
  "hindi_on": 516.135,
  "hindi_off": 522.795,
  "dur": 6.5,
  "tempo": 1.0,
  "drift": 0.011,
  "spill": 0.0,
  "early": 0.0,
  "text": "വാ, നമുക്കെല്ലാവർക്കും ചേർന്ന് പുതിയ ലഡു ഉണ്ടാക്കാം. പൂജയ്ക്ക് ഇനിയും സമയമിണ്ട്!",
  "cut": false
 },
 {
  "unit": 94,
  "start": 523.297,
  "end": 526.477,
  "hindi_on": 523.297,
  "hindi_off": 526.997,
  "dur": 3.18,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അപ്പോ ഇനി വലയും കൊണ്ട് എനിക്ക് വീഴേണ്ടി വരില്ലേ?",
  "cut": false
 },
 {
  "unit": 95,
  "start": 527.375,
  "end": 532.885,
  "hindi_on": 527.375,
  "hindi_off": 534.465,
  "dur": 5.51,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇല്ല രാജൂ, ഇനി കടലമാവിൽ കൈവെച്ചാൽ മാത്രം മതിട്ടാ!",
  "cut": false
 },
 {
  "unit": 96,
  "start": 535.402,
  "end": 541.442,
  "hindi_on": 535.402,
  "hindi_off": 541.172,
  "dur": 6.04,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "വാ, പുതിയ പ്ലാൻ ഉണ്ടാക്കാം! ലഡു ഉണ്ടാക്കുന്ന പ്ലാൻ! ഇത്തവണ പ്ലാനിൽ തെറ്റൊന്നും വരില്ല!",
  "cut": false
 },
 {
  "unit": 97,
  "start": 541.676,
  "end": 545.866,
  "hindi_on": 541.676,
  "hindi_off": 545.906,
  "dur": 4.19,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "സത്യത്തിൽ, ഗുഡിയാ, നിന്റെ എല്ലാ പ്ലാനിലും ഓരോ കുഴപ്പമുണ്ടാകും.",
  "cut": false
 },
 {
  "unit": 98,
  "start": 546.419,
  "end": 548.779,
  "hindi_on": 546.419,
  "hindi_off": 548.139,
  "dur": 2.36,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്നാൽ ഇത്തവണ അവിടെ കടലമാവ് നിറയ്ക്കും!",
  "cut": false
 },
 {
  "unit": 99,
  "start": 549.118,
  "end": 553.528,
  "hindi_on": 549.118,
  "hindi_off": 553.338,
  "dur": 4.41,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "അങ്ങനെ സോൺപൂരിലെ ഏറ്റവും രസകരമായ ലഡു നിർമ്മാണം ആരംഭിച്ചു!",
  "cut": false
 },
 {
  "unit": 100,
  "start": 553.784,
  "end": 557.734,
  "hindi_on": 553.784,
  "hindi_off": 557.664,
  "dur": 3.95,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "സത്യത്തിൽ, ലഡു ചതുരത്തിൽ ഉണ്ടാക്കണം. എങ്കിലേ കേടുകൂടാതെ ഇരിക്കൂ.",
  "cut": false
 },
 {
  "unit": 101,
  "start": 558.562,
  "end": 564.122,
  "hindi_on": 558.562,
  "hindi_off": 566.042,
  "dur": 5.56,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "പിങ്കിക്കുട്ടീ, ലഡു ഉരുണ്ടിരിക്കുന്നതാ ഭംഗി! ഇങ്ങനെ ഉരുട്ടി ഉരുട്ടി എടുക്കണംട്ടാ.",
  "cut": false
 },
 {
  "unit": 102,
  "start": 566.512,
  "end": 571.212,
  "hindi_on": 566.512,
  "hindi_off": 571.252,
  "dur": 4.7,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "നോക്ക്, രാജു ദ ഗ്രേറ്റിന്റെ സൂപ്പർ ലഡു! ഏറ്റവും വലുത്!",
  "cut": false
 },
 {
  "unit": 103,
  "start": 572.23,
  "end": 574.84,
  "hindi_on": 572.23,
  "hindi_off": 575.12,
  "dur": 2.61,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "ഇത്... ഇതൊരു പൊടി ലഡുവാ! പുതിയ ഡിസൈൻ!",
  "cut": false
 },
 {
  "unit": 104,
  "start": 576.068,
  "end": 579.198,
  "hindi_on": 576.068,
  "hindi_off": 577.928,
  "dur": 3.13,
  "tempo": 1.0,
  "drift": 0.0,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്റെ ലഡു നല്ല ഭംഗിയായി ഉരുണ്ടു വന്നിട്ടുണ്ട്!",
  "cut": false
 },
 {
  "unit": 106,
  "start": 580.032,
  "end": 584.712,
  "hindi_on": 580.032,
  "hindi_off": 581.852,
  "dur": 5.38,
  "tempo": 1.15,
  "drift": 0.0,
  "spill": 2.502,
  "early": 0.0,
  "text": "അയ്യോ പ്രേതം! എന്റെ ലഡു പ്രേതം കൊണ്ടുപോയേ!",
  "cut": false
 },
 {
  "unit": 107,
  "start": 584.832,
  "end": 587.052,
  "hindi_on": 582.33,
  "hindi_off": 584.51,
  "dur": 2.54,
  "tempo": 1.15,
  "drift": 2.502,
  "spill": 1.701,
  "early": 0.0,
  "text": "ബബ്ലൂ, അത് നമ്മടെ ചമ്മകിയാ!",
  "cut": false
 },
 {
  "unit": 108,
  "start": 587.172,
  "end": 590.102,
  "hindi_on": 585.471,
  "hindi_off": 588.171,
  "dur": 3.37,
  "tempo": 1.15,
  "drift": 1.701,
  "spill": 1.53,
  "early": 0.0,
  "text": "വയറേ, ഇത് പൂജയ്ക്കുള്ള ലഡുവാ! കുറച്ച് അടങ്ങിയിരിക്ക്!",
  "cut": false
 },
 {
  "unit": 109,
  "start": 590.222,
  "end": 593.032,
  "hindi_on": 588.692,
  "hindi_off": 592.002,
  "dur": 3.24,
  "tempo": 1.15,
  "drift": 1.53,
  "spill": 0.191,
  "early": 0.0,
  "text": "വാഹ് ചോറ്റൂ! നീയിന്ന് ശരിക്കും വലിയ കുട്ടിയായി!",
  "cut": false
 },
 {
  "unit": 110,
  "start": 593.152,
  "end": 599.072,
  "hindi_on": 592.961,
  "hindi_off": 599.631,
  "dur": 5.92,
  "tempo": 1.0,
  "drift": 0.191,
  "spill": 0.0,
  "early": 0.0,
  "text": "എന്റെ ജിലേബികൾക്ക് ഒരു കുഴപ്പവുമില്ല! സന്തോഷത്തിൽ പൂജയ്ക്കുള്ള ഈ ജിലേബികൾ എന്റെ വക!",
